#!/usr/bin/env bash
# Git Arborist (gar) - Source Checkout Launcher
# Executes the compiled Zig binary (building it automatically if needed).
set -e

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")/.." >/dev/null 2>&1 && pwd)"
ZIG_BIN="$REPO_DIR/zig-out/bin/arborist"

if [ ! -x "$ZIG_BIN" ]; then
    if command -v zig >/dev/null 2>&1; then
        (cd "$REPO_DIR" && zig build -Doptimize=ReleaseSmall >/dev/null 2>&1)
    else
        echo -e "\033[31mError:\033[0m Compiled 'arborist' binary not found at $ZIG_BIN and 'zig' is not installed." >&2
        echo "Run './install.sh' to download a prebuilt release binary or install Zig to build from source." >&2
        exit 1
    fi
fi

exec "$ZIG_BIN" "$@"

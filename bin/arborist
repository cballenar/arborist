#!/usr/bin/env bash
# Core CLI for Gar (Git Arborist)

set -e

COMMAND=${1:-}
INVOCATION_DIR="$PWD"

# Handle help command before stdout redirection so output goes to stdout
if [ "$COMMAND" = "-h" ] || [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "help" ] || [ -z "$COMMAND" ]; then
    cat << 'EOF'
Git Arborist (gar) - Multi-worktree workspace manager

Usage:
  gar <command> [arguments]

Commands:
  init <repo_url> <dir>    Initialize a new Hub and provision baseline worktree
  switch [-c] <branch>     Switch to an existing worktree or create (-c) a new one
  -m [old_branch] <new>    Move/rename a worktree, branch, and database
  remove <branch>          Remove a worktree, branch, and drop isolated database
  db <action> [options]    Database operations (import/export) (aliases: dbi, dbe)
  sync-ddev                Synchronize Hub .ddev config from tracking branch
  hook                     Output shell integration hook for eval
  -h, --help, help         Show this help message

Database Commands:
  db import [--file <f>] [--target <b>]   Import SQL dump into database (alias: dbi)
  db export [--file <f>] [--target <b>]   Export database to SQL dump (alias: dbe)

Examples:
  gar init git@github.com:org/repo.git my-project
  gar switch feature-branch
  gar switch -c new-feature
  gar -m new-feature-name
  gar remove old-feature
  gar db import
  gar dbi --file custom.sql.gz
  gar dbe --target feature-branch
EOF
    exit 0
fi

# Handle 'hook' command before stdout redirection so eval "$(gar hook)" captures the shell definition
if [ "$COMMAND" = "hook" ]; then
    BIN_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    cat << EOF
# Git Arborist (gar) shell integration
gar() {
    if [ "\$1" = "switch" ] || [ "\$1" = "-m" ]; then
        local _cmd="\$1"
        shift
        local _target_path
        _target_path="\$("$BIN_PATH" "\$_cmd" "\$@")"
        local _exit_code=\$?
        if [ \$_exit_code -eq 0 ] && [ -n "\$_target_path" ] && [ -d "\$_target_path" ]; then
            cd "\$_target_path" || return 1
        fi
        return \$_exit_code
    else
        "$BIN_PATH" "\$@"
    fi
}
alias arborist="gar"
alias dbi="gar dbi"
alias dbe="gar dbe"
EOF
    exit 0
fi

# Redirect all normal output to stderr so stdout can be used purely for cd paths
exec 3>&1
exec 1>&2

if [ -n "$COMMAND" ]; then
    shift
fi

# Where this script is located so we can find templates/
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
TEMPLATES_DIR=$(dirname "$SCRIPT_DIR")/templates

function log() {
    echo -e "$@"
}

function error_exit() {
    log "\033[31mError:\033[0m $1"
    exit 1
}

function check_hub_dir() {
    HUB_DIR=$PWD
    while [ "$HUB_DIR" != "/" ]; do
        if [ -d "$HUB_DIR/.git" ] && [ -d "$HUB_DIR/.ddev" ] || [ -f "$HUB_DIR/.arborist" ]; then
            break
        fi
        HUB_DIR=$(dirname "$HUB_DIR")
    done

    if [ "$HUB_DIR" == "/" ]; then
        error_exit "Not inside a gar hub. Could not find .git and config together."
    fi
    echo "$HUB_DIR"
}

function get_db_name() {
    local branch="$1"
    echo "db_$(echo "$branch" | sed 's/[^a-zA-Z0-9_]/_/g')"
}

function cmd_init() {
    REPO_URL=$1
    HUB_DIR_ARG=$2

    if [ -z "$REPO_URL" ] || [ -z "$HUB_DIR_ARG" ]; then
        error_exit "Usage: gar init <repo_url> <hub_dir>"
    fi

    log "Initializing Arborist Hub in $HUB_DIR_ARG..."
    mkdir -p "$HUB_DIR_ARG"
    cd "$HUB_DIR_ARG"

    # Clone as bare repository into .git
    git clone --bare "$REPO_URL" .git
    
    # Analyze HEAD
    FILES=$(git ls-tree --name-only HEAD)
    
    # 1. Environment Selection
    HAS_DDEV=$(echo "$FILES" | grep -E "^\.ddev$" || true)
    HAS_LANDO=$(echo "$FILES" | grep -E "^\.lando\.yml$" || true)
    HAS_DOCKER=$(echo "$FILES" | grep -E "^docker-compose\.yml$" || true)
    
    ENV_ENGINE=""
    if [ "$GAR_AUTO_YES" == "true" ]; then
        ENV_ENGINE="ddev"
    else
        log "Detected environments: "
        [ -n "$HAS_DDEV" ] && log " - DDEV"
        [ -n "$HAS_LANDO" ] && log " - Lando"
        [ -n "$HAS_DOCKER" ] && log " - Docker"
        
        echo "Which environment engine will this Hub use?"
        # Standardize select prompt
        PS3="Select engine (1-3): "
        select env_opt in "DDEV" "Lando" "Docker"; do
            case $env_opt in
                DDEV ) ENV_ENGINE="ddev"; break;;
                Lando ) ENV_ENGINE="lando"; break;;
                Docker ) ENV_ENGINE="docker"; break;;
            esac
        done </dev/tty
    fi

    log "Extracting environment configuration to the hub..."
    if [ "$ENV_ENGINE" == "ddev" ]; then
        git archive HEAD .ddev/ | tar -x >/dev/null 2>&1 || true
    elif [ "$ENV_ENGINE" == "lando" ]; then
        git archive HEAD .lando.yml | tar -x >/dev/null 2>&1 || true
        git archive HEAD .lando/ | tar -x >/dev/null 2>&1 || true
    elif [ "$ENV_ENGINE" == "docker" ]; then
        git archive HEAD docker-compose.yml | tar -x >/dev/null 2>&1 || true
    fi

    # 2. Sparse-Checkout Rules
    SPARSE_EXCLUDES="!/.ddev/ !/.lando.yml !/.lando/ !/docker-compose.yml"
    if [ "$GAR_AUTO_YES" != "true" ]; then
        read -p "Any other heavy directories to exclude from all worktrees? (comma-separated, e.g., docs,tests) [none]: " extra_sparse </dev/tty || true
        if [ -n "$extra_sparse" ]; then
            IFS=',' read -ra ADDR <<< "$extra_sparse"
            for i in "${ADDR[@]}"; do
                dir=$(echo "$i" | xargs) # trim whitespace
                SPARSE_EXCLUDES="$SPARSE_EXCLUDES !/$dir/"
            done
        fi
    fi

    # 3. Webroot & Framework
    GUESS_WEBROOT="docroot"
    if echo "$FILES" | grep -E "^web$" >/dev/null; then GUESS_WEBROOT="web"; fi
    if echo "$FILES" | grep -E "^public$" >/dev/null; then GUESS_WEBROOT="public"; fi
    
    if [ "$GAR_AUTO_YES" == "true" ]; then
        WEBROOT=$GUESS_WEBROOT
    else
        read -p "Where is the public webroot? (Detected: '$GUESS_WEBROOT') [$GUESS_WEBROOT]: " input_webroot </dev/tty || true
        WEBROOT=${input_webroot:-$GUESS_WEBROOT}
    fi
    
    FRAMEWORK="unknown"
    if [ -f "$WEBROOT/sites/default/settings.php" ] || git ls-tree --name-only HEAD "$WEBROOT/sites/default/settings.php" >/dev/null 2>&1; then
        FRAMEWORK="drupal"
        log "Detected framework: Drupal"
    fi

    # 4. Database Backup Path
    GUESS_BACKUP_PATH="backups"
    if echo "$FILES" | grep -E "^\.ddev/db-backups$" >/dev/null; then GUESS_BACKUP_PATH=".ddev/db-backups"; fi
    if echo "$FILES" | grep -E "^backups$" >/dev/null; then GUESS_BACKUP_PATH="backups"; fi
    if echo "$FILES" | grep -E "^dumps$" >/dev/null; then GUESS_BACKUP_PATH="dumps"; fi

    if [ "$GAR_AUTO_YES" == "true" ]; then
        DB_BACKUP_PATH=$GUESS_BACKUP_PATH
    else
        read -p "Database backup path relative to hub root? [$GUESS_BACKUP_PATH]: " input_backup </dev/tty || true
        DB_BACKUP_PATH=${input_backup:-$GUESS_BACKUP_PATH}
    fi
    mkdir -p "$DB_BACKUP_PATH"

    # Write Arborist config
    cat <<EOF > .arborist
ENV_ENGINE=$ENV_ENGINE
WEBROOT=$WEBROOT
FRAMEWORK=$FRAMEWORK
SPARSE_EXCLUDES="$SPARSE_EXCLUDES"
DB_BACKUP_PATH="$DB_BACKUP_PATH"
EOF

    # 4. Permanent Branches
    DEFAULT_BRANCH=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
    if [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "develop")
    fi
    if [ "$DEFAULT_BRANCH" == "HEAD" ] || [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH="develop"
    fi

    if [ "$GAR_AUTO_YES" != "true" ]; then
        read -p "What is the main tracking branch? (Detected: '$DEFAULT_BRANCH') [$DEFAULT_BRANCH]: " MAIN_BRANCH </dev/tty || true
        DEFAULT_BRANCH=${MAIN_BRANCH:-$DEFAULT_BRANCH}
    fi

    log "Provisioning main worktree ($DEFAULT_BRANCH)..."
    git worktree add "$DEFAULT_BRANCH" "$DEFAULT_BRANCH"
    
    cd "$DEFAULT_BRANCH"
    git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
    
    if [ "$FRAMEWORK" == "drupal" ]; then
        if [ "$GAR_AUTO_YES" == "true" ] || { read -p "Auto-inject Arborist DB routing into $WEBROOT/sites/default/settings.local.php? [Y/n]: " inject_db </dev/tty && [[ "${inject_db:-Y}" =~ ^[Yy]$ ]]; }; then
            log "Injecting settings.workspace.php..."
            mkdir -p "$WEBROOT/sites/default"
            sed "s/'develop'/'$DEFAULT_BRANCH'/g" "$TEMPLATES_DIR/settings.workspace.php" > "$WEBROOT/sites/default/settings.workspace.php"
            touch "$WEBROOT/sites/default/settings.local.php"
            if ! grep -q "settings.workspace.php" "$WEBROOT/sites/default/settings.local.php"; then
                echo "" >> "$WEBROOT/sites/default/settings.local.php"
                echo "require __DIR__ . '/settings.workspace.php';" >> "$WEBROOT/sites/default/settings.local.php"
            fi
        fi
    fi
    cd ..

    if [ "$ENV_ENGINE" == "ddev" ]; then
        log "Injecting wildcard Nginx config..."
        mkdir -p .ddev/nginx_full
        # Dynamically inject the webroot into the nginx template
        sed "s|/var/www/html/\$active_branch/docroot|/var/www/html/\$active_branch/$WEBROOT|g" "$TEMPLATES_DIR/workspace-nginx.conf" > .ddev/nginx_full/workspace-nginx.conf

        PROJECT_NAME=""
        if [ -f ".ddev/config.yaml" ]; then
            PROJECT_NAME=$(grep -E "^name:" .ddev/config.yaml | head -n1 | sed -E 's/^name:[[:space:]]*//; s/["'\'' ]//g')
        fi
        if [ -z "$PROJECT_NAME" ]; then
            PROJECT_NAME=$(basename "$PWD")
        fi

        log "Configuring DDEV wildcard routing..."
        ddev config --additional-hostnames="*.$PROJECT_NAME" || true
        if [ -f ".ddev/config.yaml" ] && ! grep -q "\*\.$PROJECT_NAME" .ddev/config.yaml; then
            if grep -q "^additional_hostnames:" .ddev/config.yaml; then
                sed "s|^additional_hostnames:.*|additional_hostnames: [\"*.$PROJECT_NAME\"]|" .ddev/config.yaml > .ddev/config.yaml.tmp && mv .ddev/config.yaml.tmp .ddev/config.yaml
            else
                echo "additional_hostnames: [\"*.$PROJECT_NAME\"]" >> .ddev/config.yaml
            fi
        fi

        log "Updating DDEV hub docroot..."
        ddev config --docroot="$DEFAULT_BRANCH/$WEBROOT" || true
        if [ -f ".ddev/config.yaml" ]; then
            if grep -q "^docroot:" .ddev/config.yaml; then
                sed "s|^docroot:.*|docroot: $DEFAULT_BRANCH/$WEBROOT|" .ddev/config.yaml > .ddev/config.yaml.tmp && mv .ddev/config.yaml.tmp .ddev/config.yaml
            else
                echo "docroot: $DEFAULT_BRANCH/$WEBROOT" >> .ddev/config.yaml
            fi
        fi
    fi

    if [ "$GAR_AUTO_YES" != "true" ]; then
        read -p "Any other permanent worktrees to provision now? (comma-separated) [none]: " extra_branches </dev/tty || true
        if [ -n "$extra_branches" ]; then
            IFS=',' read -ra ADDR <<< "$extra_branches"
            for i in "${ADDR[@]}"; do
                b=$(echo "$i" | xargs)
                log "Provisioning extra branch: $b"
                git worktree add "$b" "$b" || git worktree add "$b" -b "$b"
                cd "$b"
                git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
                cd ..
            done
        fi
    fi

    log "\nArborist hub initialized successfully."
    log "You can now start your environment at the hub root."
}

function cmd_switch() {
    CREATE_FLAG=0
    BRANCH=""

    if [ "$1" == "-c" ]; then
        CREATE_FLAG=1
        BRANCH=$2
    else
        BRANCH=$1
    fi

    if [ -z "$BRANCH" ]; then
        error_exit "Usage: gar switch [-c] <branch>"
    fi

    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || SPARSE_EXCLUDES="!/.ddev/ !/.lando.yml !/.lando/ !/docker-compose.yml"
    ENV_ENGINE=${ENV_ENGINE:-ddev}

    if [ -d "$BRANCH" ]; then
        log "Worktree '$BRANCH' already exists."
        echo "$HUB_DIR/$BRANCH" >&3
        exit 0
    fi

    if [ $CREATE_FLAG -eq 1 ]; then
        log "Creating new worktree for '$BRANCH'..."
        git worktree add "$BRANCH" -b "$BRANCH"
        
        cd "$BRANCH"
        git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
        cd ..
        
        log "Worktree provisioned."
        
        if [ "$GAR_AUTO_YES" == "true" ]; then
            create_db="y"
            log "Auto-confirming database creation for tests."
        else
            read -p "Create an isolated database for this branch? [y/N]: " create_db </dev/tty || true
        fi
        create_db=${create_db:-N}
        
        if [[ "$create_db" =~ ^[Yy]$ ]]; then
            DB_NAME=$(get_db_name "$BRANCH")
            if [ "$ENV_ENGINE" == "ddev" ]; then
                log "Cloning default database into $DB_NAME..."
                ddev mysql -e "CREATE DATABASE IF NOT EXISTS \`$DB_NAME\`;" || true
                ddev export-db --database=db | ddev import-db --database=$DB_NAME
                log "Isolated database $DB_NAME ready."
            else
                log "Automated database cloning for $ENV_ENGINE is not yet implemented."
            fi
        else
            log "Using default shared database."
        fi

        echo "$HUB_DIR/$BRANCH" >&3
    else
        # Try to checkout existing branch
        git worktree add "$BRANCH" "$BRANCH"
        cd "$BRANCH"
        git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
        cd ..
        
        log "Checked out existing branch into worktree '$BRANCH'."
        echo "$HUB_DIR/$BRANCH" >&3
    fi
}

function cmd_remove() {
    BRANCH=$1
    if [ -z "$BRANCH" ]; then
        error_exit "Usage: gar remove <branch>"
    fi

    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}

    if [ ! -d "$BRANCH" ]; then
        error_exit "Worktree '$BRANCH' not found in $HUB_DIR."
    fi

    DB_NAME=$(get_db_name "$BRANCH")

    if [ "$GAR_AUTO_YES" == "true" ]; then
        drop_db="y"
        log "Auto-confirming database drop for tests."
    else
        read -p "Drop the isolated database ($DB_NAME) if it exists? [Y/n]: " drop_db </dev/tty || true
    fi
    drop_db=${drop_db:-Y}

    log "Removing worktree '$BRANCH'..."
    git worktree remove --force "$BRANCH"
    git branch -D "$BRANCH" || true
    
    if [[ "$drop_db" =~ ^[Yy]$ ]]; then
        if [ "$ENV_ENGINE" == "ddev" ]; then
            log "Dropping database $DB_NAME..."
            ddev mysql -e "DROP DATABASE IF EXISTS \`$DB_NAME\`;" || true
        else
            log "Automated database dropping for $ENV_ENGINE is not yet implemented."
        fi
    fi

    log "Worktree '$BRANCH' dropped."
}

function cmd_sync_ddev() {
    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    
    if [ "$ENV_ENGINE" != "ddev" ]; then
        log "sync-ddev is specifically for DDEV environments."
        exit 0
    fi
    
    log "Syncing .ddev configuration from the tracking branch..."
    # Extract cleanly from tracking branch (usually develop or main)
    DEFAULT_BRANCH=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
    if [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "develop")
    fi
    if [ "$DEFAULT_BRANCH" == "HEAD" ] || [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH="develop"
    fi
    
    git archive "$DEFAULT_BRANCH" .ddev/ | tar -x || true
    
    log ".ddev synced successfully. Restarting DDEV..."
    ddev restart
}

function cmd_m() {
    if [ -z "$1" ]; then
        error_exit "Usage: gar -m [old_branch] <new_branch>"
    fi

    if [ -z "$2" ]; then
        NEW_BRANCH=$1
        OLD_BRANCH=$(basename "$PWD")
    else
        OLD_BRANCH=$1
        NEW_BRANCH=$2
    fi

    HUB_DIR=$(check_hub_dir)
    
    if [ "$OLD_BRANCH" == "$(basename "$HUB_DIR")" ]; then
         error_exit "Cannot infer worktree name from the hub root. Please run from inside a worktree or specify the old branch explicitly."
    fi

    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}

    if [ ! -d "$OLD_BRANCH" ]; then
        error_exit "Worktree '$OLD_BRANCH' does not exist."
    fi

    if [ -d "$NEW_BRANCH" ]; then
        error_exit "Target directory '$NEW_BRANCH' already exists."
    fi

    if [ "$GAR_AUTO_YES" == "true" ]; then
        confirm_move="y"
    else
        read -p "Are you sure you want to move worktree '$OLD_BRANCH' to '$NEW_BRANCH'? [y/N]: " confirm_move </dev/tty || true
    fi
    confirm_move=${confirm_move:-N}
    
    if [[ ! "$confirm_move" =~ ^[Yy]$ ]]; then
        log "Move cancelled."
        exit 0
    fi

    log "Moving worktree and branch from '$OLD_BRANCH' to '$NEW_BRANCH'..."
    
    # Move physical directory
    mv "$OLD_BRANCH" "$NEW_BRANCH"
    
    # Repair git worktree paths
    git worktree repair "$NEW_BRANCH" > /dev/null 2>&1 || true
    
    # Move/mirror git branch
    git branch -m "$OLD_BRANCH" "$NEW_BRANCH"
    
    OLD_DB_NAME=$(get_db_name "$OLD_BRANCH")
    NEW_DB_NAME=$(get_db_name "$NEW_BRANCH")

    if [ "$GAR_AUTO_YES" == "true" ]; then
        move_db="y"
    else
        read -p "Did this branch have an isolated database ($OLD_DB_NAME) that needs to be moved? [y/N]: " move_db </dev/tty || true
    fi
    move_db=${move_db:-N}

    if [[ "$move_db" =~ ^[Yy]$ ]]; then
        if [ "$ENV_ENGINE" == "ddev" ]; then
            log "Migrating database from $OLD_DB_NAME to $NEW_DB_NAME..."
            ddev mysql -e "CREATE DATABASE IF NOT EXISTS \`$NEW_DB_NAME\`;" || true
            ddev export-db --database="$OLD_DB_NAME" | ddev import-db --database="$NEW_DB_NAME"
            ddev mysql -e "DROP DATABASE \`$OLD_DB_NAME\`;" || true
            log "Database migrated successfully."
        else
            log "Automated database moving for $ENV_ENGINE is not yet implemented."
        fi
    fi

    log "Worktree moved to '$NEW_BRANCH'."
    
    # Output the new path so the shell wrapper can cd into it
    echo "$HUB_DIR/$NEW_BRANCH" >&3
}

function cmd_db() {
    ACTION=${1:-}
    if [ -z "$ACTION" ] || [ "$ACTION" == "-h" ] || [ "$ACTION" == "--help" ] || [ "$ACTION" == "help" ]; then
        cat << 'EOF'
Usage:
  gar db <action> [options]
  gar dbi [options]
  gar dbe [options]

Actions:
  import [--file <path>] [--target <branch>]   Import SQL dump into database (alias: gar dbi)
  export [--file <path>] [--target <branch>]   Export database to SQL dump (alias: gar dbe)

Options:
  --file <path>       Path to SQL dump (relative to current directory)
  --target <branch>   Target branch/database (defaults to current worktree or tracking branch)
EOF
        exit 0
    fi
    shift

    FILE_ARG=""
    TARGET_ARG=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file)
                FILE_ARG="$2"
                shift 2
                ;;
            --file=*)
                FILE_ARG="${1#*=}"
                shift
                ;;
            --target)
                TARGET_ARG="$2"
                shift 2
                ;;
            --target=*)
                TARGET_ARG="${1#*=}"
                shift
                ;;
            -h|--help|help)
                case "$ACTION" in
                    import)
                        cat << 'EOF'
Usage: gar db import [--file <path>] [--target <branch>]
Alias: gar dbi [--file <path>] [--target <branch>]

Options:
  --file <path>       Path to SQL dump (relative to current working directory).
                      If omitted, imports the latest dump from DB_BACKUP_PATH.
  --target <branch>   Target branch/database (defaults to current worktree or tracking branch).
EOF
                        ;;
                    export)
                        cat << 'EOF'
Usage: gar db export [--file <path>] [--target <branch>]
Alias: gar dbe [--file <path>] [--target <branch>]

Options:
  --file <path>       Destination path for SQL dump (relative to current working directory).
                      If omitted, saves a timestamped dump into DB_BACKUP_PATH.
  --target <branch>   Target branch/database to export (defaults to current worktree or tracking branch).
EOF
                        ;;
                    *)
                        echo "Unknown action: $ACTION"
                        ;;
                esac
                exit 0
                ;;
            *)
                if [ -z "$FILE_ARG" ] && [[ "$1" != -* ]]; then
                    FILE_ARG="$1"
                    shift
                else
                    error_exit "Unknown option for gar db $ACTION: $1"
                fi
                ;;
        esac
    done

    HUB_DIR=$(check_hub_dir)
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    DB_BACKUP_PATH=${DB_BACKUP_PATH:-backups}

    # Tracking / default branch detection
    DEFAULT_BRANCH=$(git -C "$HUB_DIR" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
    if [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH=$(git -C "$HUB_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "develop")
    fi
    if [ "$DEFAULT_BRANCH" == "HEAD" ] || [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH="develop"
    fi

    # Current worktree detection based on where command was invoked
    CURRENT_BRANCH=""
    if [ "$INVOCATION_DIR" != "$HUB_DIR" ] && [[ "$INVOCATION_DIR" == "$HUB_DIR/"* ]]; then
        REL_INVOCATION="${INVOCATION_DIR#$HUB_DIR/}"
        C_BRANCH="${REL_INVOCATION%%/*}"
        if [ -d "$HUB_DIR/$C_BRANCH" ]; then
            CURRENT_BRANCH="$C_BRANCH"
        fi
    fi

    # Determine target branch
    if [ -n "$TARGET_ARG" ]; then
        TARGET_BRANCH="$TARGET_ARG"
    elif [ -n "$CURRENT_BRANCH" ]; then
        TARGET_BRANCH="$CURRENT_BRANCH"
    else
        TARGET_BRANCH="$DEFAULT_BRANCH"
    fi

    # Determine target database name
    if [ "$TARGET_BRANCH" == "$DEFAULT_BRANCH" ] || [ "$TARGET_BRANCH" == "db" ] || [ "$TARGET_BRANCH" == "default" ]; then
        TARGET_DB="db"
    else
        TARGET_DB=$(get_db_name "$TARGET_BRANCH")
    fi

    case "$ACTION" in
        import)
            RESOLVED_FILE=""
            if [ -n "$FILE_ARG" ]; then
                if [[ "$FILE_ARG" = /* ]]; then
                    RESOLVED_FILE="$FILE_ARG"
                else
                    RESOLVED_FILE="$INVOCATION_DIR/$FILE_ARG"
                fi
                if [ -d "$(dirname "$RESOLVED_FILE")" ]; then
                    RESOLVED_FILE="$(cd "$(dirname "$RESOLVED_FILE")" && pwd)/$(basename "$RESOLVED_FILE")"
                fi
                if [ ! -f "$RESOLVED_FILE" ]; then
                    error_exit "Specified database dump file not found: $RESOLVED_FILE"
                fi
            else
                if [[ "$DB_BACKUP_PATH" = /* ]]; then
                    BACKUP_SOURCE="$DB_BACKUP_PATH"
                else
                    BACKUP_SOURCE="$HUB_DIR/$DB_BACKUP_PATH"
                fi

                if [ -f "$BACKUP_SOURCE" ]; then
                    RESOLVED_FILE="$BACKUP_SOURCE"
                elif [ -d "$BACKUP_SOURCE" ]; then
                    latest_file=""
                    for f in "$BACKUP_SOURCE"/*; do
                        [ -f "$f" ] || continue
                        case "$f" in
                            *.sql|*.sql.gz|*.sql.bz2|*.sql.xz|*.mysql|*.mysql.gz|*.tar|*.tar.gz|*.tgz|*.zip)
                                if [ -z "$latest_file" ] || [ "$f" -nt "$latest_file" ]; then
                                    latest_file="$f"
                                fi
                                ;;
                        esac
                    done
                    if [ -n "$latest_file" ]; then
                        RESOLVED_FILE="$latest_file"
                    else
                        error_exit "No database dump files found in directory: $BACKUP_SOURCE"
                    fi
                else
                    error_exit "Configured DB_BACKUP_PATH does not exist: $BACKUP_SOURCE"
                fi
            fi

            log "Importing database dump into '\033[36m$TARGET_DB\033[0m'..."
            log "Source file: $RESOLVED_FILE"
            if [ "$ENV_ENGINE" == "ddev" ]; then
                cd "$HUB_DIR"
                if [ "$TARGET_DB" != "db" ]; then
                    ddev mysql -e "CREATE DATABASE IF NOT EXISTS \`$TARGET_DB\`;" || true
                fi
                ddev import-db --database="$TARGET_DB" --file="$RESOLVED_FILE"
                log "Database '\033[32m$TARGET_DB\033[0m' imported successfully."
            else
                error_exit "Database import for engine '$ENV_ENGINE' is not yet implemented."
            fi
            ;;

        export)
            RESOLVED_FILE=""
            if [ -n "$FILE_ARG" ]; then
                if [[ "$FILE_ARG" = /* ]]; then
                    RESOLVED_FILE="$FILE_ARG"
                else
                    RESOLVED_FILE="$INVOCATION_DIR/$FILE_ARG"
                fi
                mkdir -p "$(dirname "$RESOLVED_FILE")"
                RESOLVED_FILE="$(cd "$(dirname "$RESOLVED_FILE")" && pwd)/$(basename "$RESOLVED_FILE")"
            else
                if [[ "$DB_BACKUP_PATH" = /* ]]; then
                    BACKUP_TARGET="$DB_BACKUP_PATH"
                else
                    BACKUP_TARGET="$HUB_DIR/$DB_BACKUP_PATH"
                fi

                if [ -d "$BACKUP_TARGET" ] || [[ "$DB_BACKUP_PATH" != *.* ]]; then
                    mkdir -p "$BACKUP_TARGET"
                    RESOLVED_FILE="$BACKUP_TARGET/${TARGET_DB}_$(date +%Y%m%d_%H%M%S).sql.gz"
                else
                    mkdir -p "$(dirname "$BACKUP_TARGET")"
                    RESOLVED_FILE="$BACKUP_TARGET"
                fi
            fi

            log "Exporting database '\033[36m$TARGET_DB\033[0m'..."
            log "Destination: $RESOLVED_FILE"
            if [ "$ENV_ENGINE" == "ddev" ]; then
                cd "$HUB_DIR"
                ddev export-db --database="$TARGET_DB" --file="$RESOLVED_FILE"
                log "Database exported successfully to $RESOLVED_FILE"
            else
                error_exit "Database export for engine '$ENV_ENGINE' is not yet implemented."
            fi
            ;;


        *)
            error_exit "Unknown database action: $ACTION\nRun 'gar db' to see available actions."
            ;;
    esac
}

case "$COMMAND" in
    init)
        cmd_init "$@"
        ;;
    switch)
        cmd_switch "$@"
        ;;
    remove)
        cmd_remove "$@"
        ;;
    -m)
        cmd_m "$@"
        ;;
    sync-ddev)
        cmd_sync_ddev "$@"
        ;;
    db)
        cmd_db "$@"
        ;;
    dbi)
        cmd_db import "$@"
        ;;
    dbe)
        cmd_db export "$@"
        ;;
    *)
        error_exit "Unknown command: $COMMAND\nRun 'gar -h' to see available commands."
        ;;
esac

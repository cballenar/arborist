#!/usr/bin/env bash
# Core CLI for Gar (Git Arborist)

set -e

COMMAND=${1:-}
INVOCATION_DIR="$PWD"

# Handle help command before stdout redirection so output goes to stdout
if [ "$COMMAND" = "-h" ] || [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "help" ] || [ -z "$COMMAND" ]; then
    cat << 'EOF'
Git Arborist (gar) - Multi-worktree workspace manager

Usage:
  gar <command> [arguments]

Commands:
  init <repo_url> <dir>    Initialize a new Hub and provision baseline worktree
  switch [-c] [branch]     Switch to a worktree, checkout remote, or create (-c) a new one
  list                     List all worktrees, branches, and database mappings
  prune [options]          Prune orphaned worktrees, branches, and databases (-f, --dry-run)
  -m [old_branch] <new>    Move/rename a worktree, branch, and database
  remove [options] <branch> Remove a worktree, branch, and drop isolated database (-f, -y)
  db <action> [options]    Database operations (import/export) (aliases: dbi, dbe)
  sync                     Synchronize Hub configs, wrappers, hooks, and worktree scaffolds
  install-hooks            Install Git hooks in the Hub for automatic pruning
  hook                     Output shell integration hook for eval
  -h, --help, help         Show this help message

Database Commands:
  db import [--file <f>] [--target <b>]   Import SQL dump into database (alias: dbi)
  db export [--file <f>] [--target <b>]   Export database to SQL dump (alias: dbe)

Examples:
  gar init git@github.com:org/repo.git my-project
  gar switch feature-branch
  gar switch -c new-feature
  gar -m new-feature-name
  gar remove old-feature
  gar db import
  gar dbi --file custom.sql.gz
  gar dbe --target feature-branch
EOF
    exit 0
fi

# Handle '__complete' command before stdout redirection so completion output goes to stdout
if [ "$COMMAND" = "__complete" ]; then
    shift
    TARGET_TYPE=${1:-worktrees}
    HUB_DIR=""
    cur="$PWD"
    while [ "$cur" != "/" ]; do
        if [ -d "$cur/.git" ] && [ -d "$cur/.ddev" ] || [ -f "$cur/.arborist" ]; then
            HUB_DIR="$cur"
            break
        fi
        cur=$(dirname "$cur")
    done
    if [ -n "$HUB_DIR" ] && [ -d "$HUB_DIR" ]; then
        case "$TARGET_TYPE" in
            worktrees)
                (
                    cd "$HUB_DIR" 2>/dev/null || exit 0
                    git worktree list --porcelain 2>/dev/null | awk '/^branch refs\/heads\// {sub(/^branch refs\/heads\//, ""); print}'
                    git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null
                    git for-each-ref --format='%(refname:short)' refs/remotes/origin 2>/dev/null | sed 's@^origin/@@' | grep -v '^HEAD$'
                ) | sort -u
                ;;
            branches)
                (
                    cd "$HUB_DIR" 2>/dev/null || exit 0
                    git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null
                ) | sort -u
                ;;
        esac
    fi
    exit 0
fi

# Handle 'hook' command before stdout redirection so eval "$(gar hook)" captures the shell definition
if [ "$COMMAND" = "hook" ]; then
    BIN_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    cat << EOF
# Git Arborist (gar) shell integration
gar() {
    if [ "\$1" = "switch" ] || [ "\$1" = "-m" ]; then
        local _cmd="\$1"
        shift
        local _target_path
        _target_path="\$("$BIN_PATH" "\$_cmd" "\$@")"
        local _exit_code=\$?
        if [ \$_exit_code -eq 0 ] && [ -n "\$_target_path" ] && [ -d "\$_target_path" ]; then
            cd "\$_target_path" || return 1
        fi
        return \$_exit_code
    else
        "$BIN_PATH" "\$@"
    fi
}
alias arborist="gar"
alias dbi="gar dbi"
alias dbe="gar dbe"

# Shell completion for Zsh and Bash
if [ -n "\$ZSH_VERSION" ]; then
    _gar_zsh_complete() {
        local -a commands
        commands=(
            'init:Initialize a new Hub and baseline worktree'
            'switch:Switch to a worktree or create a new one'
            'list:List all worktrees, branches, and database mappings'
            'prune:Prune orphaned worktrees, branches, and databases'
            'remove:Remove a worktree, branch, and database'
            'db:Database operations (import/export)'
            'dbi:Import database dump'
            'dbe:Export database dump'
            'sync:Synchronize Hub configs, wrappers, and scaffolds'
            'sync-ddev:Synchronize Hub configs, wrappers, and scaffolds'
            'install-hooks:Install Git hooks in the Hub'
            '-m:Move or rename a worktree and database'
        )

        if (( CURRENT == 2 )); then
            _describe -t commands 'gar command' commands
            return 0
        fi

        case "\$words[2]" in
            switch|remove|-m)
                local -a wts
                wts=(\$( "$BIN_PATH" __complete worktrees 2>/dev/null ))
                if (( \${#wts} > 0 )); then
                    _describe -t wts 'worktree / branch' wts
                fi
                ;;
            db)
                if (( CURRENT == 3 )); then
                    local -a dbcmds
                    dbcmds=('import:Import SQL dump' 'export:Export database')
                    _describe -t dbcmds 'db command' dbcmds
                fi
                ;;
            prune)
                local -a popts
                popts=('-f:Force prune without prompt' '--force:Force prune without prompt' '--dry-run:Preview pruned resources')
                _describe -t popts 'prune option' popts
                ;;
        esac
    }
    compdef _gar_zsh_complete gar arborist 2>/dev/null || true
elif [ -n "\$BASH_VERSION" ]; then
    _gar_bash_complete() {
        local cur prev words cword
        COMPREPLY=()
        cur="\${COMP_WORDS[COMP_CWORD]}"
        prev="\${COMP_WORDS[COMP_CWORD-1]}"

        local commands="init switch list prune remove db dbi dbe sync sync-ddev install-hooks -m -h help"

        if [ "\$COMP_CWORD" -eq 1 ]; then
            COMPREPLY=( \$(compgen -W "\$commands" -- "\$cur") )
            return 0
        fi

        case "\$prev" in
            switch|remove|-m)
                local wts
                wts=\$("$BIN_PATH" __complete worktrees 2>/dev/null)
                COMPREPLY=( \$(compgen -W "\$wts" -- "\$cur") )
                return 0
                ;;
            db)
                COMPREPLY=( \$(compgen -W "import export info" -- "\$cur") )
                return 0
                ;;
            prune)
                COMPREPLY=( \$(compgen -W "-f --force --dry-run" -- "\$cur") )
                return 0
                ;;
            --target)
                local branches
                branches=\$("$BIN_PATH" __complete branches 2>/dev/null)
                COMPREPLY=( \$(compgen -W "\$branches" -- "\$cur") )
                return 0
                ;;
        esac
    }
    complete -F _gar_bash_complete gar arborist 2>/dev/null || true
fi
EOF
    exit 0
fi

# Redirect all normal output to stderr so stdout can be used purely for cd paths
exec 3>&1
exec 1>&2

if [ -n "$COMMAND" ]; then
    shift
fi

# Where this script is located so we can find templates/
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
TEMPLATES_DIR=$(dirname "$SCRIPT_DIR")/templates

function log() {
    echo -e "$@"
}

function error_exit() {
    log "\033[31mError:\033[0m $1"
    exit 1
}

function check_hub_dir() {
    HUB_DIR=$PWD
    while [ "$HUB_DIR" != "/" ]; do
        if [ -d "$HUB_DIR/.git" ] && [ -d "$HUB_DIR/.ddev" ] || [ -f "$HUB_DIR/.arborist" ]; then
            break
        fi
        HUB_DIR=$(dirname "$HUB_DIR")
    done

    if [ "$HUB_DIR" == "/" ]; then
        error_exit "Not inside a gar hub. Could not find .git and config together."
    fi
    echo "$HUB_DIR"
}

function get_db_name() {
    local branch="$1"
    echo "db_$(echo "$branch" | sed 's/[^a-zA-Z0-9_]/_/g')"
}

function is_in_comma_list() {
    local item="$1"
    local list=",$2,"
    if [[ "$list" == *",$item,"* ]]; then
        return 0
    fi
    return 1
}

function is_in_space_list() {
    local item="$1"
    local list=" $2 "
    if [[ "$list" == *" $item "* ]]; then
        return 0
    fi
    return 1
}

function flush_env_sync() {
    if [ "$ENV_ENGINE" == "ddev" ]; then
        if command -v ddev >/dev/null 2>&1 && ddev describe >/dev/null 2>&1; then
            ddev mutagen sync >/dev/null 2>&1 || true
        fi
    fi
}

function provision_drupal_worktree() {
    local wt_dir="$1"
    local site_dir="$wt_dir/$WEBROOT/sites/default"
    local def_site_dir="$HUB_DIR/$DEFAULT_BRANCH/$WEBROOT/sites/default"
    
    [ -d "$site_dir" ] || mkdir -p "$site_dir"

    # Ensure injected files are excluded in git
    mkdir -p "$HUB_DIR/.git/info"
    touch "$HUB_DIR/.git/info/exclude"
    for pattern in "settings.workspace.php" "settings.local.php" "settings.ddev.php" "development.services.yml"; do
        if ! grep -q "^$pattern$" "$HUB_DIR/.git/info/exclude" 2>/dev/null; then
            echo "$pattern" >> "$HUB_DIR/.git/info/exclude"
        fi
    done

    # 1. settings.workspace.php
    if [ ! -f "$site_dir/settings.workspace.php" ]; then
        if [ -f "$def_site_dir/settings.workspace.php" ]; then
            cp "$def_site_dir/settings.workspace.php" "$site_dir/settings.workspace.php"
        elif [ -f "$TEMPLATES_DIR/settings.workspace.php" ]; then
            sed "s/'develop'/'$DEFAULT_BRANCH'/g" "$TEMPLATES_DIR/settings.workspace.php" > "$site_dir/settings.workspace.php"
        fi
    fi

    # 2. settings.ddev.php
    if [ "$ENV_ENGINE" == "ddev" ] && [ ! -f "$site_dir/settings.ddev.php" ]; then
        if [ -f "$def_site_dir/settings.ddev.php" ]; then
            cp "$def_site_dir/settings.ddev.php" "$site_dir/settings.ddev.php"
        fi
    fi

    # 3. settings.local.php
    if [ ! -f "$site_dir/settings.local.php" ]; then
        if [ -f "$def_site_dir/settings.local.php" ]; then
            cp "$def_site_dir/settings.local.php" "$site_dir/settings.local.php"
        else
            echo "<?php" > "$site_dir/settings.local.php"
            echo "if (file_exists(__DIR__ . '/settings.workspace.php')) {" >> "$site_dir/settings.local.php"
            echo "    require __DIR__ . '/settings.workspace.php';" >> "$site_dir/settings.local.php"
            echo "}" >> "$site_dir/settings.local.php"
        fi
    elif ! grep -q "settings.workspace.php" "$site_dir/settings.local.php"; then
        echo "" >> "$site_dir/settings.local.php"
        echo "if (file_exists(__DIR__ . '/settings.workspace.php')) {" >> "$site_dir/settings.local.php"
        echo "    require __DIR__ . '/settings.workspace.php';" >> "$site_dir/settings.local.php"
        echo "}" >> "$site_dir/settings.local.php"
    fi

    # 4. development.services.yml (needed for cache.backend.null and local development overrides)
    local sites_dir="$wt_dir/$WEBROOT/sites"
    local def_sites_dir="$HUB_DIR/$DEFAULT_BRANCH/$WEBROOT/sites"
    if [ ! -f "$sites_dir/development.services.yml" ]; then
        if [ -f "$def_sites_dir/development.services.yml" ]; then
            cp "$def_sites_dir/development.services.yml" "$sites_dir/development.services.yml"
        elif [ -f "$wt_dir/$WEBROOT/core/assets/scaffold/files/development.services.yml" ]; then
            cp "$wt_dir/$WEBROOT/core/assets/scaffold/files/development.services.yml" "$sites_dir/development.services.yml"
        fi
    fi
}

function install_git_hooks() {
    local hub_dir="$1"
    local hooks_dir="$hub_dir/.git/hooks"
    mkdir -p "$hooks_dir"

    # Configure fetch.prune and remote.origin.fetch so remote branch deletions are automatically detected
    git -C "$hub_dir" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*" 2>/dev/null || true
    git -C "$hub_dir" config fetch.prune true 2>/dev/null || true

    # 1. post-merge hook (runs after git pull / git merge in any worktree)
    cat << 'EOF' > "$hooks_dir/post-merge"
#!/usr/bin/env bash
# Git Arborist post-merge hook
# Automatically cleans up orphaned databases and worktrees if DDEV is running.
if command -v gar >/dev/null 2>&1; then
    gar prune --hook >/dev/null 2>&1 || true
fi
EOF
    chmod +x "$hooks_dir/post-merge"

    # 2. reference-transaction hook (Git 2.29+, runs on ref updates and deletions)
    cat << 'EOF' > "$hooks_dir/reference-transaction"
#!/usr/bin/env bash
# Git Arborist reference-transaction hook
# Automatically cleans up orphaned databases and worktrees when branches are deleted.
state="$1"
if [ "$state" = "committed" ]; then
    while read -r oldrev newrev refname; do
        if [ "$newrev" = "0000000000000000000000000000000000000000" ] && [[ "$refname" =~ ^refs/heads/ ]]; then
            if command -v gar >/dev/null 2>&1; then
                gar prune --hook >/dev/null 2>&1 || true
                break
            fi
        fi
    done
fi
EOF
    chmod +x "$hooks_dir/reference-transaction"
}

function cmd_install_hooks() {
    HUB_DIR=$(check_hub_dir)
    install_git_hooks "$HUB_DIR"
    log "Git Arborist hooks installed successfully in $HUB_DIR/.git/hooks"
}

function cmd_init() {
    REPO_URL=$1
    HUB_DIR_ARG=$2

    if [ -z "$REPO_URL" ] || [ -z "$HUB_DIR_ARG" ]; then
        error_exit "Usage: gar init <repo_url> <hub_dir>"
    fi

    log "Initializing Arborist Hub in $HUB_DIR_ARG..."
    mkdir -p "$HUB_DIR_ARG"
    cd "$HUB_DIR_ARG"

    # Clone as bare repository into .git
    git clone --bare "$REPO_URL" .git
    git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
    git fetch origin >/dev/null 2>&1 || true
    
    # Analyze HEAD
    FILES=$(git ls-tree --name-only HEAD)
    
    # 1. Environment Selection
    HAS_DDEV=$(echo "$FILES" | grep -E "^\.ddev$" || true)
    HAS_LANDO=$(echo "$FILES" | grep -E "^\.lando\.yml$" || true)
    HAS_DOCKER=$(echo "$FILES" | grep -E "^docker-compose\.yml$" || true)
    
    ENV_ENGINE=""
    if [ "$GAR_AUTO_YES" == "true" ]; then
        ENV_ENGINE="ddev"
    else
        log "Detected environments: "
        [ -n "$HAS_DDEV" ] && log " - DDEV"
        [ -n "$HAS_LANDO" ] && log " - Lando"
        [ -n "$HAS_DOCKER" ] && log " - Docker"
        
        echo "Which environment engine will this Hub use?"
        # Standardize select prompt
        PS3="Select engine (1-3): "
        select env_opt in "DDEV" "Lando" "Docker"; do
            case $env_opt in
                DDEV ) ENV_ENGINE="ddev"; break;;
                Lando ) ENV_ENGINE="lando"; break;;
                Docker ) ENV_ENGINE="docker"; break;;
            esac
        done </dev/tty
    fi

    log "Extracting environment configuration to the hub..."
    if [ "$ENV_ENGINE" == "ddev" ]; then
        git archive HEAD .ddev/ | tar -x >/dev/null 2>&1 || true
    elif [ "$ENV_ENGINE" == "lando" ]; then
        git archive HEAD .lando.yml | tar -x >/dev/null 2>&1 || true
        git archive HEAD .lando/ | tar -x >/dev/null 2>&1 || true
    elif [ "$ENV_ENGINE" == "docker" ]; then
        git archive HEAD docker-compose.yml | tar -x >/dev/null 2>&1 || true
    fi

    # 2. Sparse-Checkout Rules
    SPARSE_EXCLUDES="!/.ddev/ !/.lando.yml !/.lando/ !/docker-compose.yml"
    if [ "$GAR_AUTO_YES" != "true" ]; then
        read -p "Any other heavy directories to exclude from all worktrees? (comma-separated, e.g., docs,tests) [none]: " extra_sparse </dev/tty || true
        if [ -n "$extra_sparse" ]; then
            IFS=',' read -ra ADDR <<< "$extra_sparse"
            for i in "${ADDR[@]}"; do
                dir=$(echo "$i" | xargs) # trim whitespace
                SPARSE_EXCLUDES="$SPARSE_EXCLUDES !/$dir/"
            done
        fi
    fi

    # 3. Webroot & Framework
    GUESS_WEBROOT="docroot"
    if echo "$FILES" | grep -E "^web$" >/dev/null; then GUESS_WEBROOT="web"; fi
    if echo "$FILES" | grep -E "^public$" >/dev/null; then GUESS_WEBROOT="public"; fi
    
    if [ "$GAR_AUTO_YES" == "true" ]; then
        WEBROOT=$GUESS_WEBROOT
    else
        read -p "Where is the public webroot? (Detected: '$GUESS_WEBROOT') [$GUESS_WEBROOT]: " input_webroot </dev/tty || true
        WEBROOT=${input_webroot:-$GUESS_WEBROOT}
    fi
    
    FRAMEWORK="unknown"
    if [ -f "$WEBROOT/sites/default/settings.php" ] || git ls-tree --name-only HEAD "$WEBROOT/sites/default/settings.php" >/dev/null 2>&1; then
        FRAMEWORK="drupal"
        log "Detected framework: Drupal"
    fi

    # 4. Database Backup Path
    GUESS_BACKUP_PATH="backups"
    if echo "$FILES" | grep -E "^\.ddev/db-backups$" >/dev/null; then GUESS_BACKUP_PATH=".ddev/db-backups"; fi
    if echo "$FILES" | grep -E "^backups$" >/dev/null; then GUESS_BACKUP_PATH="backups"; fi
    if echo "$FILES" | grep -E "^dumps$" >/dev/null; then GUESS_BACKUP_PATH="dumps"; fi

    if [ "$GAR_AUTO_YES" == "true" ]; then
        DB_BACKUP_PATH=$GUESS_BACKUP_PATH
    else
        read -p "Database backup path relative to hub root? [$GUESS_BACKUP_PATH]: " input_backup </dev/tty || true
        DB_BACKUP_PATH=${input_backup:-$GUESS_BACKUP_PATH}
    fi
    mkdir -p "$DB_BACKUP_PATH"

    # 4. Permanent Branches
    DEFAULT_BRANCH=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
    DEFAULT_BRANCH=${DEFAULT_BRANCH:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)}
    DEFAULT_BRANCH=${DEFAULT_BRANCH:-develop}
    if [ "$DEFAULT_BRANCH" == "HEAD" ]; then
        DEFAULT_BRANCH="develop"
    fi

    if [ "$GAR_AUTO_YES" != "true" ]; then
        read -p "What is the main tracking branch? (Detected: '$DEFAULT_BRANCH') [$DEFAULT_BRANCH]: " MAIN_BRANCH </dev/tty || true
        DEFAULT_BRANCH=${MAIN_BRANCH:-$DEFAULT_BRANCH}
    fi

    # 5. Post-provision Commands
    POST_PROVISION_CMD=""
    if [ "$FRAMEWORK" == "drupal" ]; then
        SUGGESTED_POST_PROVISION="ddev drush updb -y && ddev drush cim -y && ddev drush cr && ddev drush uli"
        if [ "$GAR_AUTO_YES" == "true" ]; then
            POST_PROVISION_CMD="$SUGGESTED_POST_PROVISION"
        else
            read -p "Post-provision command for new branches? [$SUGGESTED_POST_PROVISION]: " input_post_prov </dev/tty || true
            POST_PROVISION_CMD=${input_post_prov:-$SUGGESTED_POST_PROVISION}
        fi
    else
        if [ "$GAR_AUTO_YES" != "true" ]; then
            read -p "Post-provision command for new branches? (e.g., composer install) [none]: " input_post_prov </dev/tty || true
            POST_PROVISION_CMD=${input_post_prov:-}
        fi
    fi

    safe_post_prov=$(echo "$POST_PROVISION_CMD" | sed 's/\\/\\\\/g; s/"/\\"/g')

    # Write Arborist config
    cat <<EOF > .arborist
ENV_ENGINE=$ENV_ENGINE
WEBROOT=$WEBROOT
FRAMEWORK=$FRAMEWORK
SPARSE_EXCLUDES="$SPARSE_EXCLUDES"
DB_BACKUP_PATH="$DB_BACKUP_PATH"
DEFAULT_BRANCH="$DEFAULT_BRANCH"
PROTECTED_BRANCHES="$DEFAULT_BRANCH,develop,main,master"
PRUNE_TARGETS="both"
POST_PROVISION_CMD="$safe_post_prov"
EOF

    log "Configuring Git hooks and automated remote branch pruning..."
    install_git_hooks "$PWD"

    log "Provisioning main worktree ($DEFAULT_BRANCH)..."
    git worktree add "$DEFAULT_BRANCH" "$DEFAULT_BRANCH"
    
    cd "$DEFAULT_BRANCH"
    git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
    
    if [ "$FRAMEWORK" == "drupal" ]; then
        if [ "$GAR_AUTO_YES" == "true" ] || { read -p "Auto-inject Arborist DB routing into $WEBROOT/sites/default/settings.local.php? [Y/n]: " inject_db </dev/tty && [[ "${inject_db:-Y}" =~ ^[Yy]$ ]]; }; then
            log "Injecting settings.workspace.php..."
            mkdir -p "$WEBROOT/sites/default"
            sed "s/'develop'/'$DEFAULT_BRANCH'/g" "$TEMPLATES_DIR/settings.workspace.php" > "$WEBROOT/sites/default/settings.workspace.php"
            touch "$WEBROOT/sites/default/settings.local.php"
            if ! grep -q "settings.workspace.php" "$WEBROOT/sites/default/settings.local.php"; then
                echo "" >> "$WEBROOT/sites/default/settings.local.php"
                echo "require __DIR__ . '/settings.workspace.php';" >> "$WEBROOT/sites/default/settings.local.php"
            fi
            if [ ! -f "$WEBROOT/sites/development.services.yml" ] && [ -f "$WEBROOT/core/assets/scaffold/files/development.services.yml" ]; then
                cp "$WEBROOT/core/assets/scaffold/files/development.services.yml" "$WEBROOT/sites/development.services.yml"
            fi
        fi
    fi
    cd ..

    if [ "$ENV_ENGINE" == "ddev" ]; then
        log "Injecting wildcard Nginx config..."
        mkdir -p .ddev/nginx_full
        # Dynamically inject the webroot and default branch into the nginx template
        sed -e "s|/docroot|/$WEBROOT|g" -e "s|DEFAULT_BRANCH_PLACEHOLDER|$DEFAULT_BRANCH|g" "$TEMPLATES_DIR/workspace-nginx.conf" > .ddev/nginx_full/workspace-nginx.conf

        PROJECT_NAME=""
        if [ -f ".ddev/config.yaml" ]; then
            PROJECT_NAME=$(grep -E "^name:" .ddev/config.yaml | head -n1 | sed -E 's/^name:[[:space:]]*//; s/["'\'' ]//g')
        fi
        if [ -z "$PROJECT_NAME" ]; then
            PROJECT_NAME=$(basename "$PWD")
        fi

        log "Configuring DDEV wildcard routing..."
        ddev config --additional-hostnames="*.$PROJECT_NAME" || true
        if [ -f ".ddev/config.yaml" ] && ! grep -q "\*\.$PROJECT_NAME" .ddev/config.yaml; then
            if grep -q "^additional_hostnames:" .ddev/config.yaml; then
                sed "s|^additional_hostnames:.*|additional_hostnames: [\"*.$PROJECT_NAME\"]|" .ddev/config.yaml > .ddev/config.yaml.tmp && mv .ddev/config.yaml.tmp .ddev/config.yaml
            else
                echo "additional_hostnames: [\"*.$PROJECT_NAME\"]" >> .ddev/config.yaml
            fi
        fi

        log "Updating DDEV hub docroot..."
        ddev config --docroot="$DEFAULT_BRANCH/$WEBROOT" || true
        if [ -f ".ddev/config.yaml" ]; then
            if grep -q "^docroot:" .ddev/config.yaml; then
                sed "s|^docroot:.*|docroot: $DEFAULT_BRANCH/$WEBROOT|" .ddev/config.yaml > .ddev/config.yaml.tmp && mv .ddev/config.yaml.tmp .ddev/config.yaml
            else
                echo "docroot: $DEFAULT_BRANCH/$WEBROOT" >> .ddev/config.yaml
            fi
        fi

        if [ -d "$TEMPLATES_DIR/ddev-commands" ]; then
            log "Injecting DDEV command wrappers..."
            mkdir -p .ddev/commands/web
            for cmd_file in "$TEMPLATES_DIR/ddev-commands"/*; do
                [ -f "$cmd_file" ] || continue
                cp "$cmd_file" ".ddev/commands/web/$(basename "$cmd_file")"
                chmod +x ".ddev/commands/web/$(basename "$cmd_file")"
            done
        fi
    fi

    if [ "$GAR_AUTO_YES" != "true" ]; then
        read -p "Any other permanent worktrees to provision now? (comma-separated) [none]: " extra_branches </dev/tty || true
        if [ -n "$extra_branches" ]; then
            IFS=',' read -ra ADDR <<< "$extra_branches"
            for i in "${ADDR[@]}"; do
                b=$(echo "$i" | xargs)
                log "Provisioning extra branch: $b"
                git worktree add "$b" "$b" || git worktree add "$b" -b "$b"
                cd "$b"
                git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
                cd ..
                if [ "$FRAMEWORK" == "drupal" ]; then
                    provision_drupal_worktree "$PWD/$b"
                fi
            done
        fi
    fi

    log "\nArborist hub initialized successfully."
    log "You can now start your environment at the hub root."
}

function cmd_switch() {
    local CREATE_FLAG=0
    local BRANCH=""

    if [ "$1" == "-c" ]; then
        CREATE_FLAG=1
        BRANCH=$2
    else
        BRANCH=$1
    fi

    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    SPARSE_EXCLUDES=${SPARSE_EXCLUDES:-"!/.ddev/ !/.lando.yml !/.lando/ !/docker-compose.yml"}
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    DEFAULT_BRANCH=${DEFAULT_BRANCH:-develop}

    # 1. No branch argument: interactive selection or fallback to DEFAULT_BRANCH
    if [ -z "$BRANCH" ]; then
        local -a wt_list=()
        while IFS= read -r line; do
            [ -n "$line" ] && wt_list+=("$line")
        done < <(git worktree list --porcelain 2>/dev/null | awk '/^branch refs\/heads\// {sub(/^branch refs\/heads\//, ""); print}')

        if [ ${#wt_list[@]} -le 1 ] || [ "$GAR_AUTO_YES" == "true" ] || [ ! -t 0 ]; then
            BRANCH="$DEFAULT_BRANCH"
        else
            log "Select a worktree to switch to:"
            local idx=1
            for wt in "${wt_list[@]}"; do
                if [ "$wt" == "$DEFAULT_BRANCH" ]; then
                    log "  $idx) $wt (tracking)"
                else
                    log "  $idx) $wt"
                fi
                idx=$((idx + 1))
            done
            read -p "Select worktree [1-${#wt_list[@]}] (default: 1): " choice </dev/tty || choice=1
            choice=${choice:-1}
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#wt_list[@]} ]; then
                BRANCH="${wt_list[$((choice - 1))]}"
            else
                error_exit "Invalid selection: $choice"
            fi
        fi
    fi

    # 2. Existing worktree directory or branch already checked out: switch into it
    local existing_wt=""
    if [ -d "$BRANCH" ]; then
        existing_wt="$HUB_DIR/$BRANCH"
    else
        local cur_parse_wt=""
        while IFS= read -r line; do
            if [[ "$line" =~ ^worktree[[:space:]]+(.*) ]]; then
                cur_parse_wt="${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^branch[[:space:]]+refs/heads/(.*) ]]; then
                if [ "${BASH_REMATCH[1]}" = "$BRANCH" ]; then
                    existing_wt="$cur_parse_wt"
                    break
                fi
            fi
        done < <(git worktree list --porcelain 2>/dev/null)
    fi

    if [ -n "$existing_wt" ] && [ -d "$existing_wt" ]; then
        if [ "$FRAMEWORK" == "drupal" ]; then
            provision_drupal_worktree "$existing_wt"
        fi
        local rel_wt="./${existing_wt#$HUB_DIR/}"
        log "Switched to worktree '$rel_wt'."
        echo "$existing_wt" >&3
        exit 0
    fi

    # 3. Worktree does not exist yet: determine whether local, remote, or brand new
    local has_local_branch=false
    local has_remote_branch=false

    if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
        has_local_branch=true
    fi
    if git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
        has_remote_branch=true
    fi

    if [ $CREATE_FLAG -eq 1 ]; then
        log "Creating new worktree and branch for '$BRANCH'..."
        git worktree add "$BRANCH" -b "$BRANCH"
    elif [ "$has_local_branch" = true ]; then
        log "Checking out existing branch into worktree '$BRANCH'..."
        git worktree add "$BRANCH" "$BRANCH"
    elif [ "$has_remote_branch" = true ]; then
        log "Found remote branch 'origin/$BRANCH'. Checking out tracking worktree..."
        git worktree add "$BRANCH" --track -b "$BRANCH" "origin/$BRANCH"
    else
        # Branch not found locally or remotely, and -c was not specified
        if [ "$GAR_AUTO_YES" != "true" ] && [ -t 0 ]; then
            read -p "Branch '$BRANCH' not found locally or on remote. Create it now? [Y/n]: " create_confirm </dev/tty || create_confirm=Y
            create_confirm=${create_confirm:-Y}
            if [[ "$create_confirm" =~ ^[Yy]$ ]]; then
                log "Creating new worktree and branch for '$BRANCH'..."
                git worktree add "$BRANCH" -b "$BRANCH"
            else
                log "Switch cancelled."
                exit 0
            fi
        elif [ "$GAR_AUTO_YES" == "true" ]; then
            log "Creating new worktree and branch for '$BRANCH'..."
            git worktree add "$BRANCH" -b "$BRANCH"
        else
            error_exit "Branch '$BRANCH' not found. Use 'gar switch -c $BRANCH' to create it."
        fi
    fi

    # Apply sparse-checkout and provision environment
    cd "$BRANCH"
    git sparse-checkout set --no-cone '/*' $SPARSE_EXCLUDES
    cd ..
    
    if [ "$FRAMEWORK" == "drupal" ]; then
        provision_drupal_worktree "$HUB_DIR/$BRANCH"
    fi

    flush_env_sync

    log "Worktree provisioned."

    # Database handling for new worktree
    DB_NAME=$(get_db_name "$BRANCH")
    local db_exists=false
    if [ "$ENV_ENGINE" == "ddev" ]; then
        if [ -n "$GAR_MOCK_DBS" ]; then
            is_in_space_list "$DB_NAME" "$GAR_MOCK_DBS" && db_exists=true
        elif ddev describe >/dev/null 2>&1; then
            if ddev mysql -N -e "SHOW DATABASES LIKE '$DB_NAME';" 2>/dev/null | grep -q "^$DB_NAME$"; then
                db_exists=true
            fi
        fi
    fi

    if [ "$db_exists" = true ]; then
        log "Found existing isolated database '$DB_NAME'. Using it."
    else
        if [ "$GAR_AUTO_YES" == "true" ]; then
            create_db="y"
            log "Auto-confirming database creation for tests."
        else
            read -p "Create an isolated database for this branch? [Y/n]: " create_db </dev/tty || true
        fi
        create_db=${create_db:-Y}

        if [[ "$create_db" =~ ^[Yy]$ ]]; then
            if [ "$ENV_ENGINE" == "ddev" ]; then
                log "Cloning default database into $DB_NAME..."
                ddev mysql -e "CREATE DATABASE IF NOT EXISTS \`$DB_NAME\`;" || true
                ddev export-db --database=db | ddev import-db --database=$DB_NAME
                log "Isolated database $DB_NAME ready."
            else
                log "Automated database cloning for $ENV_ENGINE is not yet implemented."
            fi
        else
            log "Using default shared database."
        fi
    fi

    # Run post-provision commands on new worktree if configured
    if [ -n "$POST_PROVISION_CMD" ]; then
        flush_env_sync
        log "Running post-provision commands in '$BRANCH'..."
        (
            set -e
            cd "$HUB_DIR/$BRANCH"
            eval "$POST_PROVISION_CMD"
        ) || {
            log "\033[31mError:\033[0m Post-provision command failed with exit code $?. Aborted remaining commands."
        }
    fi

    echo "$HUB_DIR/$BRANCH" >&3
}

function cmd_remove() {
    local FORCE=false
    local BRANCH=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force|-y)
                FORCE=true
                shift
                ;;
            -h|--help)
                cat << 'EOF'
Usage: gar remove [options] <branch>

Remove a worktree, branch, and drop isolated database.

Options:
  -f, --force, -y    Skip confirmation prompt and drop isolated database
  -h, --help         Show this help message
EOF
                exit 0
                ;;
            -*)
                error_exit "Unknown option: $1\nUsage: gar remove [-f|--force] <branch>"
                ;;
            *)
                if [ -z "$BRANCH" ]; then
                    BRANCH="$1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$BRANCH" ]; then
        error_exit "Usage: gar remove [-f|--force] <branch>"
    fi

    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}

    if [ ! -d "$BRANCH" ]; then
        error_exit "Worktree '$BRANCH' not found in $HUB_DIR."
    fi

    DB_NAME=$(get_db_name "$BRANCH")

    if [ "$FORCE" = true ] || [ "$GAR_AUTO_YES" == "true" ]; then
        drop_db="y"
        if [ "$FORCE" = false ] && [ "$GAR_AUTO_YES" == "true" ]; then
            log "Auto-confirming database drop for tests."
        fi
    else
        read -p "Drop the isolated database ($DB_NAME) if it exists? [Y/n]: " drop_db </dev/tty || true
    fi
    drop_db=${drop_db:-Y}

    log "Removing worktree '$BRANCH'..."
    git worktree remove --force "$BRANCH"
    git branch -D "$BRANCH" || true
    
    if [[ "$drop_db" =~ ^[Yy]$ ]]; then
        if [ "$ENV_ENGINE" == "ddev" ]; then
            log "Dropping database $DB_NAME..."
            ddev mysql -e "DROP DATABASE IF EXISTS \`$DB_NAME\`;" || true
        else
            log "Automated database dropping for $ENV_ENGINE is not yet implemented."
        fi
    fi

    log "Worktree '$BRANCH' dropped."
}

function cmd_list() {
    local SHOW_ALL=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--all)
                SHOW_ALL=true
                shift
                ;;
            -h|--help)
                cat << 'EOF'
Usage: gar list [options]

List active worktrees, databases, and environment statuses.

Options:
  -a, --all    Also list Git branches without worktrees
  -h, --help   Show this help message
EOF
                exit 0
                ;;
            *)
                shift
                ;;
        esac
    done

    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"

    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    DEFAULT_BRANCH=${DEFAULT_BRANCH:-develop}
    PROTECTED_BRANCHES=${PROTECTED_BRANCHES:-"$DEFAULT_BRANCH,develop,main,master,production,staging"}

    local existing_dbs=""
    local ddev_running=false
    if [ "$ENV_ENGINE" == "ddev" ]; then
        if [ -n "$GAR_MOCK_DBS" ]; then
            ddev_running=true
            existing_dbs="$GAR_MOCK_DBS"
        elif ddev describe >/dev/null 2>&1; then
            ddev_running=true
            existing_dbs=$(ddev mysql -N -e "SHOW DATABASES;" 2>/dev/null | grep -E '^db$|^db_' || true)
        fi
    fi

    log "=== Git Arborist Workspaces & Databases ==="
    log "Hub: $HUB_DIR"
    if [ "$ENV_ENGINE" == "ddev" ] && [ "$ddev_running" = false ]; then
        log "\033[33mNote:\033[0m DDEV is not running. Database status cannot be queried."
    fi
    log ""

    local PROCESSED_BRANCHES=" "
    local PROCESSED_DBS=" "

    # 1. Parse worktrees
    local cur_wt=""
    local cur_branch=""
    local -a wt_paths=()
    local -a wt_branches=()

    local is_bare=false
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ ^worktree[[:space:]]+(.*) ]]; then
            cur_wt="${BASH_REMATCH[1]}"
            cur_branch=""
            is_bare=false
        elif [ "$line" = "bare" ]; then
            is_bare=true
        elif [[ "$line" =~ ^branch[[:space:]]+refs/heads/(.*) ]]; then
            cur_branch="${BASH_REMATCH[1]}"
        elif [ -z "$line" ] && [ -n "$cur_wt" ]; then
            if [ "$is_bare" = false ] && [ -n "$cur_branch" ]; then
                wt_paths+=("$cur_wt")
                wt_branches+=("$cur_branch")
            fi
            cur_wt=""
            cur_branch=""
            is_bare=false
        fi
    done < <(git worktree list --porcelain && echo "")
    if [ -n "$cur_wt" ] && [ "$is_bare" = false ] && [ -n "$cur_branch" ]; then
        wt_paths+=("$cur_wt")
        wt_branches+=("$cur_branch")
    fi

    local -a row_icons=()
    local -a row_status_texts=()
    local -a row_lines1=()
    local -a row_lines2=()
    local -a row_lines3=()
    local -a row_db_statuses=()

    local max_s=6
    local max_w=9
    local max_d=9

    local i=0
    while [ $i -lt ${#wt_paths[@]} ]; do
        local wt="${wt_paths[$i]}"
        local branch="${wt_branches[$i]}"
        local wt_rel="./${wt#$HUB_DIR/}"
        PROCESSED_BRANCHES="$PROCESSED_BRANCHES$branch "

        local db_name
        if [ "$branch" == "$DEFAULT_BRANCH" ]; then
            db_name="db"
        else
            db_name=$(get_db_name "$branch")
        fi
        PROCESSED_DBS="$PROCESSED_DBS$db_name "

        local track=""
        if [ "$branch" != "detached" ]; then
            track=$(git for-each-ref --format '%(upstream:track)' "refs/heads/$branch" 2>/dev/null || true)
        fi

        local icon="⚪"
        local status_text="Valid"

        local is_active=false
        if [ "$INVOCATION_DIR" = "$wt" ] || [[ "$INVOCATION_DIR" == "$wt/"* ]]; then
            is_active=true
        fi

        if [ "$track" = "[gone]" ]; then
            if [ "$is_active" = true ]; then
                icon="🟢"
                status_text="Active ([gone])"
            else
                icon="🔴"
                status_text="Orphaned ([gone])"
            fi
        elif [ "$is_active" = true ]; then
            icon="🟢"
            status_text="Active"
        elif is_in_comma_list "$branch" "$PROTECTED_BRANCHES"; then
            icon="🟡"
            status_text="Protect"
        else
            icon="⚪"
            status_text="Valid"
        fi

        local db_status="Ready"
        if [ "$ddev_running" = false ]; then
            db_status="Unknown"
        else
            if [ "$branch" == "$DEFAULT_BRANCH" ]; then
                if is_in_space_list "db" "$existing_dbs"; then
                    db_status="Default"
                else
                    db_status="Missing"
                fi
            else
                if is_in_space_list "$db_name" "$existing_dbs"; then
                    db_status="Ready"
                else
                    db_status="Missing"
                fi
            fi
        fi

        local l1="Branch:   $branch"
        local l2="Worktree: $wt_rel"
        local l3="Database: $db_name"

        row_icons+=("$icon")
        row_status_texts+=("$status_text")
        row_lines1+=("$l1")
        row_lines2+=("$l2")
        row_lines3+=("$l3")
        row_db_statuses+=("$db_status")

        [ ${#status_text} -gt $max_s ] && max_s=${#status_text}
        [ ${#l1} -gt $max_w ] && max_w=${#l1}
        [ ${#l2} -gt $max_w ] && max_w=${#l2}
        [ ${#l3} -gt $max_w ] && max_w=${#l3}
        [ ${#db_status} -gt $max_d ] && max_d=${#db_status}

        i=$((i + 1))
    done

    # 2. Databases in MySQL without worktree
    if [ "$ddev_running" = true ]; then
        for db in $existing_dbs; do
            if ! is_in_space_list "$db" "$PROCESSED_DBS"; then
                local icon="🔴"
                local status_text="Orphaned"
                local l1="Database: $db"
                local db_status="Orphaned"

                if [ "$db" == "db" ]; then
                    icon="🟡"
                    status_text="Protect"
                    db_status="Default"
                fi

                row_icons+=("$icon")
                row_status_texts+=("$status_text")
                row_lines1+=("$l1")
                row_lines2+=("")
                row_lines3+=("")
                row_db_statuses+=("$db_status")

                [ ${#status_text} -gt $max_s ] && max_s=${#status_text}
                [ ${#l1} -gt $max_w ] && max_w=${#l1}
                [ ${#db_status} -gt $max_d ] && max_d=${#db_status}
            fi
        done
    fi

    # 3. Optional: List branches without worktrees only when --all is passed
    if [ "$SHOW_ALL" = true ]; then
        while IFS='|' read -r bname btrack; do
            if [ -n "$bname" ] && ! is_in_space_list "$bname" "$PROCESSED_BRANCHES"; then
                local db_name
                if [ "$bname" == "$DEFAULT_BRANCH" ]; then
                    db_name="db"
                else
                    db_name=$(get_db_name "$bname")
                fi

                local icon="⚪"
                local status_text="Valid"
                if is_in_comma_list "$bname" "$PROTECTED_BRANCHES"; then
                    icon="🟡"
                    status_text="Protect"
                elif [ "$btrack" = "[gone]" ]; then
                    icon="🔴"
                    status_text="Orphaned ([gone])"
                fi

                local db_status="No worktree"
                if [ "$ddev_running" = true ]; then
                    if is_in_space_list "$db_name" "$existing_dbs"; then
                        db_status="Ready"
                    else
                        db_status="Missing"
                    fi
                elif [ "$ddev_running" = false ]; then
                    db_status="Unknown"
                fi

                local l1="Branch:   $bname"
                local l2="Worktree: <none>"
                local l3="Database: $db_name"

                row_icons+=("$icon")
                row_status_texts+=("$status_text")
                row_lines1+=("$l1")
                row_lines2+=("$l2")
                row_lines3+=("$l3")
                row_db_statuses+=("$db_status")

                [ ${#status_text} -gt $max_s ] && max_s=${#status_text}
                [ ${#l1} -gt $max_w ] && max_w=${#l1}
                [ ${#l2} -gt $max_w ] && max_w=${#l2}
                [ ${#l3} -gt $max_w ] && max_w=${#l3}
                [ ${#db_status} -gt $max_d ] && max_d=${#db_status}
            fi
        done < <(git for-each-ref --format '%(refname:short)|%(upstream:track)' refs/heads)
    fi

    # Print dynamically formatted table
    local status_col_width=$((max_s + 3))
    local sep_s=$(printf "%0.s-" $(seq 1 $status_col_width))
    local sep_d=$(printf "%0.s-" $(seq 1 $max_d))
    local sep_w=$(printf "%0.s-" $(seq 1 $max_w))

    printf "%-${status_col_width}s  %-${max_d}s  %s\n" "STATUS" "DB STATUS" "WORKSPACE"
    printf "%-${status_col_width}s  %-${max_d}s  %s\n" "$sep_s" "$sep_d" "$sep_w"

    local j=0
    while [ $j -lt ${#row_lines1[@]} ]; do
        local icon="${row_icons[$j]}"
        local stext="${row_status_texts[$j]}"
        local l1="${row_lines1[$j]}"
        local l2="${row_lines2[$j]}"
        local l3="${row_lines3[$j]}"
        local dstat="${row_db_statuses[$j]}"

        printf "%s %-${max_s}s  %-${max_d}s  %s\n" "$icon" "$stext" "$dstat" "$l1"
        if [ -n "$l2" ]; then
            printf "%${status_col_width}s  %${max_d}s  %s\n" "" "" "$l2"
        fi
        if [ -n "$l3" ]; then
            printf "%${status_col_width}s  %${max_d}s  %s\n" "" "" "$l3"
        fi

        echo ""
        j=$((j + 1))
    done
}

function cmd_prune() {
    local FORCE=false
    local DRY_RUN=false
    local IS_HOOK=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force)
                FORCE=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --hook)
                IS_HOOK=true
                FORCE=true
                shift
                ;;
            -h|--help)
                cat << 'EOF'
Usage: gar prune [options]

Prune orphaned worktrees, branches, and isolated databases.

Options:
  -f, --force     Skip confirmation prompt and prune clean resources
  --dry-run       Show what would be pruned without deleting anything
  --hook          Non-interactive mode for Git hooks (exits if engine offline)
  -h, --help      Show this help message
EOF
                exit 0
                ;;
            *)
                error_exit "Unknown option: $1\nUsage: gar prune [-f|--force] [--dry-run]"
                ;;
        esac
    done

    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"

    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    DEFAULT_BRANCH=${DEFAULT_BRANCH:-develop}
    PROTECTED_BRANCHES=${PROTECTED_BRANCHES:-"$DEFAULT_BRANCH,develop,main,master,production,staging"}
    PRUNE_TARGETS=${PRUNE_TARGETS:-both}

    # Ensure hooks are installed in this hub
    if [ ! -f "$HUB_DIR/.git/hooks/post-merge" ]; then
        install_git_hooks "$HUB_DIR" >/dev/null 2>&1 || true
    fi

    # Check if DDEV is running
    local ddev_running=false
    local existing_dbs=""
    if [ "$ENV_ENGINE" == "ddev" ]; then
        if [ -n "$GAR_MOCK_DBS" ]; then
            ddev_running=true
            existing_dbs="$GAR_MOCK_DBS"
        elif ddev describe >/dev/null 2>&1; then
            ddev_running=true
            existing_dbs=$(ddev mysql -N -e "SHOW DATABASES;" 2>/dev/null | grep -E '^db$|^db_' || true)
        fi
    fi

    # In hook mode, if DDEV is offline, exit immediately
    if [ "$IS_HOOK" = true ] && [ "$ENV_ENGINE" == "ddev" ] && [ "$ddev_running" = false ]; then
        exit 0
    fi

    local -a prune_wts=()
    local -a prune_branches=()
    local -a prune_dbs=()
    local -a dirty_wts=()
    local -a active_wts=()

    # 1. Parse all worktrees
    local cur_wt=""
    local cur_branch=""
    local -a wt_paths=()
    local -a wt_branches=()

    local is_bare=false
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ ^worktree[[:space:]]+(.*) ]]; then
            cur_wt="${BASH_REMATCH[1]}"
            cur_branch=""
            is_bare=false
        elif [ "$line" = "bare" ]; then
            is_bare=true
        elif [[ "$line" =~ ^branch[[:space:]]+refs/heads/(.*) ]]; then
            cur_branch="${BASH_REMATCH[1]}"
        elif [ -z "$line" ] && [ -n "$cur_wt" ]; then
            if [ "$is_bare" = false ] && [ -n "$cur_branch" ]; then
                wt_paths+=("$cur_wt")
                wt_branches+=("$cur_branch")
            fi
            cur_wt=""
            cur_branch=""
            is_bare=false
        fi
    done < <(git worktree list --porcelain && echo "")
    if [ -n "$cur_wt" ] && [ "$is_bare" = false ] && [ -n "$cur_branch" ]; then
        wt_paths+=("$cur_wt")
        wt_branches+=("$cur_branch")
    fi

    # Map of all branches
    local -a all_heads=()
    local -a all_tracks=()
    while IFS='|' read -r bname btrack; do
        if [ -n "$bname" ]; then
            all_heads+=("$bname")
            all_tracks+=("$btrack")
        fi
    done < <(git for-each-ref --format '%(refname:short)|%(upstream:track)' refs/heads)

    # 2. Check for branches whose upstream is [gone]
    local i=0
    while [ $i -lt ${#all_heads[@]} ]; do
        local b="${all_heads[$i]}"
        local tr="${all_tracks[$i]}"

        if [ "$tr" = "[gone]" ] && ! is_in_comma_list "$b" "$PROTECTED_BRANCHES"; then
            # Find worktree path for this branch
            local found_wt=""
            local j=0
            while [ $j -lt ${#wt_branches[@]} ]; do
                if [ "${wt_branches[$j]}" = "$b" ]; then
                    found_wt="${wt_paths[$j]}"
                    break
                fi
                j=$((j + 1))
            done

            local skip_branch=false
            if [ -n "$found_wt" ] && [ -d "$found_wt" ]; then
                # Check if active
                if [ "$INVOCATION_DIR" = "$found_wt" ] || [[ "$INVOCATION_DIR" == "$found_wt/"* ]]; then
                    active_wts+=("$b:$found_wt")
                    skip_branch=true
                # Check if dirty
                elif [ -n "$(git -C "$found_wt" status --porcelain 2>/dev/null | grep -v -E '(settings\.workspace\.php|settings\.local\.php|settings\.ddev\.php|development\.services\.yml)')" ]; then
                    dirty_wts+=("$b:$found_wt")
                    skip_branch=true
                else
                    prune_wts+=("$found_wt")
                fi
            fi

            if [ "$skip_branch" = false ]; then
                prune_branches+=("$b")
                local db_name=$(get_db_name "$b")
                if [ "$ddev_running" = true ] && is_in_space_list "$db_name" "$existing_dbs"; then
                    prune_dbs+=("$db_name")
                fi
            fi
        fi
        i=$((i + 1))
    done

    # 3. Check for orphaned databases in MySQL (databases with no active git branch)
    if [ "$ddev_running" = true ]; then
        for db in $existing_dbs; do
            if [ "$db" == "db" ]; then
                continue
            fi
            # Check if this db is in prune_dbs
            local already_queued=false
            for qd in "${prune_dbs[@]}"; do
                if [ "$qd" == "$db" ]; then
                    already_queued=true
                    break
                fi
            done
            if [ "$already_queued" = true ]; then
                continue
            fi

            # Check if db belongs to ANY active branch
            local has_branch=false
            for b in "${all_heads[@]}"; do
                if [ "$(get_db_name "$b")" == "$db" ]; then
                    has_branch=true
                    break
                fi
            done

            if [ "$has_branch" = false ]; then
                # Check if protected
                local is_prot=false
                for pb in $(echo "$PROTECTED_BRANCHES" | tr ',' ' '); do
                    if [ "$(get_db_name "$pb")" == "$db" ]; then
                        is_prot=true
                        break
                    fi
                done
                if [ "$is_prot" = false ]; then
                    prune_dbs+=("$db")
                fi
            fi
        done
    fi

    # Report dirty or active worktrees skipped
    for dw in "${dirty_wts[@]}"; do
        local b_name="${dw%%:*}"
        log "\033[33m⚠️  Skipping dirty worktree '$b_name' (has uncommitted changes). Clean or commit before pruning.\033[0m"
    done
    for aw in "${active_wts[@]}"; do
        local b_name="${aw%%:*}"
        log "\033[33m⚠️  Skipping active worktree '$b_name' (currently in use).\033[0m"
    done

    local total_targets=$((${#prune_wts[@]} + ${#prune_branches[@]} + ${#prune_dbs[@]}))
    if [ $total_targets -eq 0 ]; then
        if [ "$IS_HOOK" = false ]; then
            log "No orphaned worktrees or databases found. Everything is in sync."
        fi
        exit 0
    fi

    log "The following orphaned resources were found:"
    for wt in "${prune_wts[@]}"; do
        log "  • Worktree: ./$(basename "$wt")"
    done
    for b in "${prune_branches[@]}"; do
        log "  • Branch:   $b (remote [gone])"
    done
    for db in "${prune_dbs[@]}"; do
        log "  • Database: $db"
    done
    log ""

    if [ "$DRY_RUN" = true ]; then
        log "Dry-run mode: No resources were removed."
        exit 0
    fi

    if [ "$FORCE" = false ]; then
        if [ "$GAR_AUTO_YES" == "true" ]; then
            confirm="y"
        else
            read -p "Prune these orphaned resources? [y/N]: " confirm </dev/tty || true
        fi
        confirm=${confirm:-N}
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            log "Pruning cancelled."
            exit 0
        fi
    fi

    # Perform pruning according to PRUNE_TARGETS
    local count_wts=0
    local count_branches=0
    local count_dbs=0

    if [ "$PRUNE_TARGETS" = "both" ] || [ "$PRUNE_TARGETS" = "worktree" ]; then
        for wt in "${prune_wts[@]}"; do
            log "Removing worktree $(basename "$wt")..."
            git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
            count_wts=$((count_wts + 1))
        done
        for b in "${prune_branches[@]}"; do
            log "Deleting branch $b..."
            git branch -D "$b" 2>/dev/null || true
            count_branches=$((count_branches + 1))
        done
        git worktree prune 2>/dev/null || true
    fi

    if [ "$PRUNE_TARGETS" = "both" ] || [ "$PRUNE_TARGETS" = "db" ]; then
        if [ "$ENV_ENGINE" == "ddev" ] && [ "$ddev_running" = true ]; then
            for db in "${prune_dbs[@]}"; do
                log "Dropping database $db..."
                ddev mysql -e "DROP DATABASE IF EXISTS \`$db\`;" 2>/dev/null || true
                count_dbs=$((count_dbs + 1))
            done
        fi
    fi

    log "✅ Pruning complete: removed $count_wts worktree(s), deleted $count_branches branch(es), dropped $count_dbs database(s)."
}

function cmd_sync() {
    HUB_DIR=$(check_hub_dir)
    cd "$HUB_DIR"
    
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    DEFAULT_BRANCH=${DEFAULT_BRANCH:-develop}
    FRAMEWORK=${FRAMEWORK:-drupal}
    WEBROOT=${WEBROOT:-docroot}

    log "🌳 Synchronizing Arborist Hub configuration..."

    # 1. Sync Git configuration and hooks
    log "  • Updating Git hooks and fetch configurations..."
    install_git_hooks "$HUB_DIR"

    # 2. Sync Git exclude patterns
    log "  • Updating Git exclude patterns..."
    mkdir -p "$HUB_DIR/.git/info"
    touch "$HUB_DIR/.git/info/exclude"
    for pattern in "settings.workspace.php" "settings.local.php" "settings.ddev.php" "development.services.yml"; do
        if ! grep -q "^$pattern$" "$HUB_DIR/.git/info/exclude" 2>/dev/null; then
            echo "$pattern" >> "$HUB_DIR/.git/info/exclude"
        fi
    done

    # 3. Sync Environment Engine configurations
    if [ "$ENV_ENGINE" == "ddev" ]; then
        log "  • Updating DDEV command wrappers..."
        if [ -d "$TEMPLATES_DIR/ddev-commands" ]; then
            mkdir -p .ddev/commands/web
            for cmd_file in "$TEMPLATES_DIR/ddev-commands"/*; do
                [ -f "$cmd_file" ] || continue
                cp "$cmd_file" ".ddev/commands/web/$(basename "$cmd_file")"
                chmod +x ".ddev/commands/web/$(basename "$cmd_file")"
            done
        fi

        log "  • Updating Nginx wildcard configuration..."
        mkdir -p .ddev/nginx_full
        sed -e "s|/docroot|/$WEBROOT|g" -e "s|DEFAULT_BRANCH_PLACEHOLDER|$DEFAULT_BRANCH|g" "$TEMPLATES_DIR/workspace-nginx.conf" > .ddev/nginx_full/workspace-nginx.conf

        log "  • Verifying DDEV wildcard routing and docroot..."
        local project_name=""
        if [ -f ".ddev/config.yaml" ]; then
            project_name=$(grep -E "^name:" .ddev/config.yaml | head -n1 | sed -E 's/^name:[[:space:]]*//; s/["'\'' ]//g')
        fi
        if [ -z "$project_name" ]; then
            project_name=$(basename "$PWD")
        fi

        ddev config --additional-hostnames="*.$project_name" >/dev/null 2>&1 || true
        ddev config --docroot="$DEFAULT_BRANCH/$WEBROOT" >/dev/null 2>&1 || true
    fi

    # 4. Sync and heal all active worktrees
    log "  • Auditing and healing active worktrees..."
    local cur_wt=""
    local is_bare=false
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ ^worktree[[:space:]]+(.*) ]]; then
            cur_wt="${BASH_REMATCH[1]}"
            is_bare=false
        elif [ "$line" = "bare" ]; then
            is_bare=true
        elif [ -z "$line" ] && [ -n "$cur_wt" ]; then
            if [ "$is_bare" = false ] && [ -d "$cur_wt" ]; then
                if [ "$FRAMEWORK" == "drupal" ]; then
                    provision_drupal_worktree "$cur_wt"
                fi
            fi
            cur_wt=""
            is_bare=false
        fi
    done < <(git worktree list --porcelain 2>/dev/null && echo "")
    if [ -n "$cur_wt" ] && [ "$is_bare" = false ] && [ -d "$cur_wt" ]; then
        if [ "$FRAMEWORK" == "drupal" ]; then
            provision_drupal_worktree "$cur_wt"
        fi
    fi

    flush_env_sync

    log ""
    log "✅ Arborist hub synchronized successfully!"
    if [ "$ENV_ENGINE" == "ddev" ] && ddev describe >/dev/null 2>&1; then
        log "💡 Run 'ddev restart' to reload Nginx and container configurations."
    fi
}

function cmd_sync_ddev() {
    cmd_sync "$@"
}

function cmd_m() {
    if [ -z "$1" ]; then
        error_exit "Usage: gar -m [old_branch] <new_branch>"
    fi

    HUB_DIR=$(check_hub_dir)
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}

    if [ -z "$2" ]; then
        NEW_BRANCH=$1
        OLD_BRANCH=""
        if [ "$INVOCATION_DIR" != "$HUB_DIR" ] && [[ "$INVOCATION_DIR" == "$HUB_DIR/"* ]]; then
            local wt_top
            wt_top=$(git -C "$INVOCATION_DIR" rev-parse --show-toplevel 2>/dev/null || true)
            if [ -n "$wt_top" ] && [ "$wt_top" != "$HUB_DIR" ]; then
                local b
                b=$(git -C "$wt_top" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
                if [ -n "$b" ] && [ "$b" != "HEAD" ]; then
                    OLD_BRANCH="$b"
                else
                    OLD_BRANCH="${wt_top#$HUB_DIR/}"
                fi
            fi
        fi
        if [ -z "$OLD_BRANCH" ]; then
            error_exit "Cannot infer worktree name from the hub root. Please run from inside a worktree or specify the old branch explicitly."
        fi
    else
        OLD_BRANCH=$1
        NEW_BRANCH=$2
    fi

    cd "$HUB_DIR"

    if [ ! -d "$OLD_BRANCH" ]; then
        error_exit "Worktree '$OLD_BRANCH' does not exist."
    fi

    if [ -d "$NEW_BRANCH" ]; then
        error_exit "Target directory '$NEW_BRANCH' already exists."
    fi

    if [ "$GAR_AUTO_YES" == "true" ]; then
        confirm_move="y"
    else
        read -p "Are you sure you want to move worktree '$OLD_BRANCH' to '$NEW_BRANCH'? [y/N]: " confirm_move </dev/tty || true
    fi
    confirm_move=${confirm_move:-N}
    
    if [[ ! "$confirm_move" =~ ^[Yy]$ ]]; then
        log "Move cancelled."
        exit 0
    fi

    log "Moving worktree and branch from '$OLD_BRANCH' to '$NEW_BRANCH'..."
    
    # Move physical directory
    mv "$OLD_BRANCH" "$NEW_BRANCH"
    
    # Repair git worktree paths
    git worktree repair "$NEW_BRANCH" > /dev/null 2>&1 || true
    
    # Move/mirror git branch
    git branch -m "$OLD_BRANCH" "$NEW_BRANCH"
    
    OLD_DB_NAME=$(get_db_name "$OLD_BRANCH")
    NEW_DB_NAME=$(get_db_name "$NEW_BRANCH")

    if [ "$GAR_AUTO_YES" == "true" ]; then
        move_db="y"
    else
        read -p "Did this branch have an isolated database ($OLD_DB_NAME) that needs to be moved? [y/N]: " move_db </dev/tty || true
    fi
    move_db=${move_db:-N}

    if [[ "$move_db" =~ ^[Yy]$ ]]; then
        if [ "$ENV_ENGINE" == "ddev" ]; then
            log "Migrating database from $OLD_DB_NAME to $NEW_DB_NAME..."
            ddev mysql -e "CREATE DATABASE IF NOT EXISTS \`$NEW_DB_NAME\`;" || true
            ddev export-db --database="$OLD_DB_NAME" | ddev import-db --database="$NEW_DB_NAME"
            ddev mysql -e "DROP DATABASE \`$OLD_DB_NAME\`;" || true
            log "Database migrated successfully."
        else
            log "Automated database moving for $ENV_ENGINE is not yet implemented."
        fi
    fi

    flush_env_sync

    log "Worktree moved to '$NEW_BRANCH'."
    
    # Output the new path so the shell wrapper can cd into it
    echo "$HUB_DIR/$NEW_BRANCH" >&3
}

function cmd_db() {
    ACTION=${1:-}
    if [ -z "$ACTION" ] || [ "$ACTION" == "-h" ] || [ "$ACTION" == "--help" ] || [ "$ACTION" == "help" ]; then
        cat << 'EOF'
Usage:
  gar db <action> [options]
  gar dbi [options]
  gar dbe [options]

Actions:
  import [--file <path>] [--target <branch>]   Import SQL dump into database (alias: gar dbi)
  export [--file <path>] [--target <branch>]   Export database to SQL dump (alias: gar dbe)

Options:
  --file <path>       Path to SQL dump (relative to current directory)
  --target <branch>   Target branch/database (defaults to current worktree or tracking branch)
EOF
        exit 0
    fi
    shift

    FILE_ARG=""
    TARGET_ARG=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file)
                FILE_ARG="$2"
                shift 2
                ;;
            --file=*)
                FILE_ARG="${1#*=}"
                shift
                ;;
            --target)
                TARGET_ARG="$2"
                shift 2
                ;;
            --target=*)
                TARGET_ARG="${1#*=}"
                shift
                ;;
            -h|--help|help)
                case "$ACTION" in
                    import)
                        cat << 'EOF'
Usage: gar db import [--file <path>] [--target <branch>]
Alias: gar dbi [--file <path>] [--target <branch>]

Options:
  --file <path>       Path to SQL dump (relative to current working directory).
                      If omitted, imports the latest dump from DB_BACKUP_PATH.
  --target <branch>   Target branch/database (defaults to current worktree or tracking branch).
EOF
                        ;;
                    export)
                        cat << 'EOF'
Usage: gar db export [--file <path>] [--target <branch>]
Alias: gar dbe [--file <path>] [--target <branch>]

Options:
  --file <path>       Destination path for SQL dump (relative to current working directory).
                      If omitted, saves a timestamped dump into DB_BACKUP_PATH.
  --target <branch>   Target branch/database to export (defaults to current worktree or tracking branch).
EOF
                        ;;
                    *)
                        echo "Unknown action: $ACTION"
                        ;;
                esac
                exit 0
                ;;
            *)
                if [ -z "$FILE_ARG" ] && [[ "$1" != -* ]]; then
                    FILE_ARG="$1"
                    shift
                else
                    error_exit "Unknown option for gar db $ACTION: $1"
                fi
                ;;
        esac
    done

    HUB_DIR=$(check_hub_dir)
    source "$HUB_DIR/.arborist" 2>/dev/null || true
    ENV_ENGINE=${ENV_ENGINE:-ddev}
    DB_BACKUP_PATH=${DB_BACKUP_PATH:-backups}

    # Tracking / default branch detection
    if [ -z "$DEFAULT_BRANCH" ]; then
        DEFAULT_BRANCH=$(git -C "$HUB_DIR" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
        DEFAULT_BRANCH=${DEFAULT_BRANCH:-$(git -C "$HUB_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)}
        DEFAULT_BRANCH=${DEFAULT_BRANCH:-develop}
    fi
    if [ "$DEFAULT_BRANCH" == "HEAD" ]; then
        DEFAULT_BRANCH="develop"
    fi

    # Current worktree detection based on where command was invoked
    CURRENT_BRANCH=""
    if [ "$INVOCATION_DIR" != "$HUB_DIR" ] && [[ "$INVOCATION_DIR" == "$HUB_DIR/"* ]]; then
        local wt_top
        wt_top=$(git -C "$INVOCATION_DIR" rev-parse --show-toplevel 2>/dev/null || true)
        if [ -n "$wt_top" ] && [ "$wt_top" != "$HUB_DIR" ]; then
            local b
            b=$(git -C "$wt_top" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
            if [ -n "$b" ] && [ "$b" != "HEAD" ]; then
                CURRENT_BRANCH="$b"
            else
                CURRENT_BRANCH="${wt_top#$HUB_DIR/}"
            fi
        fi
    fi

    # Determine target branch
    if [ -n "$TARGET_ARG" ]; then
        TARGET_BRANCH="$TARGET_ARG"
    elif [ -n "$CURRENT_BRANCH" ]; then
        TARGET_BRANCH="$CURRENT_BRANCH"
    else
        TARGET_BRANCH="$DEFAULT_BRANCH"
    fi

    # Determine target database name
    if [ "$TARGET_BRANCH" == "$DEFAULT_BRANCH" ] || [ "$TARGET_BRANCH" == "db" ] || [ "$TARGET_BRANCH" == "default" ]; then
        TARGET_DB="db"
    else
        TARGET_DB=$(get_db_name "$TARGET_BRANCH")
    fi

    case "$ACTION" in
        import)
            RESOLVED_FILE=""
            if [ -n "$FILE_ARG" ]; then
                if [[ "$FILE_ARG" = /* ]]; then
                    RESOLVED_FILE="$FILE_ARG"
                else
                    RESOLVED_FILE="$INVOCATION_DIR/$FILE_ARG"
                fi
                if [ -d "$(dirname "$RESOLVED_FILE")" ]; then
                    RESOLVED_FILE="$(cd "$(dirname "$RESOLVED_FILE")" && pwd)/$(basename "$RESOLVED_FILE")"
                fi
                if [ ! -f "$RESOLVED_FILE" ]; then
                    error_exit "Specified database dump file not found: $RESOLVED_FILE"
                fi
            else
                if [[ "$DB_BACKUP_PATH" = /* ]]; then
                    BACKUP_SOURCE="$DB_BACKUP_PATH"
                else
                    BACKUP_SOURCE="$HUB_DIR/$DB_BACKUP_PATH"
                fi

                if [ -f "$BACKUP_SOURCE" ]; then
                    RESOLVED_FILE="$BACKUP_SOURCE"
                elif [ -d "$BACKUP_SOURCE" ]; then
                    latest_file=""
                    for f in "$BACKUP_SOURCE"/*; do
                        [ -f "$f" ] || continue
                        case "$f" in
                            *.sql|*.sql.gz|*.sql.bz2|*.sql.xz|*.mysql|*.mysql.gz|*.tar|*.tar.gz|*.tgz|*.zip)
                                if [ -z "$latest_file" ] || [ "$f" -nt "$latest_file" ]; then
                                    latest_file="$f"
                                fi
                                ;;
                        esac
                    done
                    if [ -n "$latest_file" ]; then
                        RESOLVED_FILE="$latest_file"
                    else
                        error_exit "No database dump files found in directory: $BACKUP_SOURCE"
                    fi
                else
                    error_exit "Configured DB_BACKUP_PATH does not exist: $BACKUP_SOURCE"
                fi
            fi

            log "Importing database dump into '\033[36m$TARGET_DB\033[0m'..."
            log "Source file: $RESOLVED_FILE"
            if [ "$ENV_ENGINE" == "ddev" ]; then
                cd "$HUB_DIR"
                if [ "$TARGET_DB" != "db" ]; then
                    ddev mysql -e "CREATE DATABASE IF NOT EXISTS \`$TARGET_DB\`;" || true
                fi
                ddev import-db --database="$TARGET_DB" --file="$RESOLVED_FILE"
                log "Database '\033[32m$TARGET_DB\033[0m' imported successfully."
            else
                error_exit "Database import for engine '$ENV_ENGINE' is not yet implemented."
            fi
            ;;

        export)
            RESOLVED_FILE=""
            if [ -n "$FILE_ARG" ]; then
                if [[ "$FILE_ARG" = /* ]]; then
                    RESOLVED_FILE="$FILE_ARG"
                else
                    RESOLVED_FILE="$INVOCATION_DIR/$FILE_ARG"
                fi
                mkdir -p "$(dirname "$RESOLVED_FILE")"
                RESOLVED_FILE="$(cd "$(dirname "$RESOLVED_FILE")" && pwd)/$(basename "$RESOLVED_FILE")"
            else
                if [[ "$DB_BACKUP_PATH" = /* ]]; then
                    BACKUP_TARGET="$DB_BACKUP_PATH"
                else
                    BACKUP_TARGET="$HUB_DIR/$DB_BACKUP_PATH"
                fi

                if [ -d "$BACKUP_TARGET" ] || [[ "$DB_BACKUP_PATH" != *.* ]]; then
                    mkdir -p "$BACKUP_TARGET"
                    RESOLVED_FILE="$BACKUP_TARGET/${TARGET_DB}_$(date +%Y%m%d_%H%M%S).sql.gz"
                else
                    mkdir -p "$(dirname "$BACKUP_TARGET")"
                    RESOLVED_FILE="$BACKUP_TARGET"
                fi
            fi

            log "Exporting database '\033[36m$TARGET_DB\033[0m'..."
            log "Destination: $RESOLVED_FILE"
            if [ "$ENV_ENGINE" == "ddev" ]; then
                cd "$HUB_DIR"
                ddev export-db --database="$TARGET_DB" --file="$RESOLVED_FILE"
                log "Database exported successfully to $RESOLVED_FILE"
            else
                error_exit "Database export for engine '$ENV_ENGINE' is not yet implemented."
            fi
            ;;


        *)
            error_exit "Unknown database action: $ACTION\nRun 'gar db' to see available actions."
            ;;
    esac
}

case "$COMMAND" in
    init)
        cmd_init "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    prune)
        cmd_prune "$@"
        ;;
    install-hooks)
        cmd_install_hooks "$@"
        ;;
    switch)
        cmd_switch "$@"
        ;;
    remove)
        cmd_remove "$@"
        ;;
    -m)
        cmd_m "$@"
        ;;
    sync|update|sync-ddev)
        cmd_sync "$@"
        ;;
    db)
        cmd_db "$@"
        ;;
    dbi)
        cmd_db import "$@"
        ;;
    dbe)
        cmd_db export "$@"
        ;;
    *)
        error_exit "Unknown command: $COMMAND\nRun 'gar -h' to see available commands."
        ;;
esac

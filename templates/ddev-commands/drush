#!/usr/bin/env bash
## Description: Run drush inside active worktree
## Usage: drush [flags] [args]
## Example: "ddev drush status"
## ExecRaw: true
## HostWorkingDir: true

# Detect Hub root
HUB_ROOT="/var/www/html"
SEARCH_DIR="$PWD"
while [ "$SEARCH_DIR" != "/" ]; do
    if [ -f "$SEARCH_DIR/.arborist" ] || [ -d "$SEARCH_DIR/.ddev" ]; then
        HUB_ROOT="$SEARCH_DIR"
        break
    fi
    SEARCH_DIR=$(dirname "$SEARCH_DIR")
done
[ -d "$HUB_ROOT" ] && HUB_ROOT=$(cd "$HUB_ROOT" && pwd -P)

# Detect worktree directory (prefer git rev-parse, fallback to directory traversal)
WT_DIR=""
GIT_TOP=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$GIT_TOP" ]; then
    [ -d "$GIT_TOP" ] && GIT_TOP=$(cd "$GIT_TOP" && pwd -P)
    if [ "$GIT_TOP" != "$HUB_ROOT" ]; then
        WT_DIR="$GIT_TOP"
    fi
fi

# Look for vendor/bin/drush in current worktree or upwards
DRUSH_PATH=""
if [ -n "$WT_DIR" ] && [ -x "$WT_DIR/vendor/bin/drush" ]; then
    DRUSH_PATH="$WT_DIR/vendor/bin/drush"
fi

if [ -z "$DRUSH_PATH" ]; then
    CUR_DIR="$PWD"
    while [ "$CUR_DIR" != "$HUB_ROOT" ] && [ "$CUR_DIR" != "/" ]; do
        if [ -x "$CUR_DIR/vendor/bin/drush" ]; then
            DRUSH_PATH="$CUR_DIR/vendor/bin/drush"
            [ -z "$WT_DIR" ] && WT_DIR="$CUR_DIR"
            break
        fi
        CUR_DIR=$(dirname "$CUR_DIR")
    done
fi

# Detect default branch from .arborist configuration
DEFAULT_BRANCH=""
if [ -f "$HUB_ROOT/.arborist" ]; then
    DEFAULT_BRANCH=$(grep '^DEFAULT_BRANCH=' "$HUB_ROOT/.arborist" | cut -d'=' -f2 | tr -d '"' 2>/dev/null || true)
fi
DEFAULT_BRANCH="${DEFAULT_BRANCH:-develop}"

# If not found and at hub root, try default branch
DEFAULT_WT=$(echo "$DEFAULT_BRANCH" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/^-*//' -e 's/-*$//')
if [ -z "$DRUSH_PATH" ] && [ -x "$HUB_ROOT/$DEFAULT_WT/vendor/bin/drush" ]; then
    DRUSH_PATH="$HUB_ROOT/$DEFAULT_WT/vendor/bin/drush"
    [ -z "$WT_DIR" ] && WT_DIR="$HUB_ROOT/$DEFAULT_WT"
fi

# Source worktree .env environment variables if present
if [ -n "$WT_DIR" ] && [ -f "$WT_DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$WT_DIR/.env"
    set +a
    if [ -f "$WT_DIR/.env.local" ]; then
        set -a
        # shellcheck disable=SC1090
        . "$WT_DIR/.env.local"
        set +a
    fi
elif [ -f "./.env" ]; then
    set -a
    # shellcheck disable=SC1090
    . "./.env"
    set +a
    if [ -f "./.env.local" ]; then
        set -a
        # shellcheck disable=SC1090
        . "./.env.local"
        set +a
    fi
fi

# Detect workspace URI if not already passed in arguments
HAS_URI=false
for arg in "$@"; do
    if [[ "$arg" == --uri=* ]] || [[ "$arg" == -l=* ]]; then
        HAS_URI=true
        break
    fi
done

URI_ARG=()
if [ "$HAS_URI" = false ] && [ -n "$DDEV_PRIMARY_URL" ]; then
    WT_NAME=""
    if [ -n "$WT_DIR" ] && [ "$WT_DIR" != "$HUB_ROOT" ]; then
        WT_NAME="${WT_DIR#$HUB_ROOT/}"
    elif [ "$PWD" != "$HUB_ROOT" ] && [[ "$PWD" == "$HUB_ROOT/"* ]]; then
        WT_NAME="${PWD#$HUB_ROOT/}"
    fi
    WT_NAME="${WT_NAME%/}"

    SCHEME="${DDEV_SCHEME:-https}"
    BASE_DOMAIN="${DDEV_PRIMARY_URL#*://}"
    BASE_DOMAIN="${BASE_DOMAIN%%/*}"

    NORM_WT=$(echo "$WT_NAME" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/^-*//' -e 's/-*$//')
    NORM_DEF=$(echo "$DEFAULT_BRANCH" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/^-*//' -e 's/-*$//')
    if [ -n "$WT_NAME" ] && [ "$NORM_WT" != "$NORM_DEF" ]; then
        SUBDOMAIN="$NORM_WT"
        TARGET_URI="${SCHEME}://${SUBDOMAIN}.${BASE_DOMAIN}"
    else
        TARGET_URI="$DDEV_PRIMARY_URL"
    fi
    URI_ARG=("--uri=$TARGET_URI")
fi

if [ -n "$DRUSH_PATH" ]; then
    exec "$DRUSH_PATH" "${URI_ARG[@]}" "$@"
elif command -v drush >/dev/null 2>&1; then
    exec drush "${URI_ARG[@]}" "$@"
else
    echo "drush is not available in $PWD. Ensure drush is installed in your worktree." >&2
    exit 1
fi
